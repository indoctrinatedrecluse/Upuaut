<Window x:Class="Upuaut.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upuaut Setup" Width="960" Height="620" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#090A0D" Foreground="#E5E7EB" FontFamily="Segoe UI Variable Text"
        Loaded="Window_Loaded">
    <Grid ClipToBounds="True">
        <MediaElement x:Name="InstallVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      Stretch="UniformToFill" Volume="0" IsMuted="True" Opacity="0.25" MediaEnded="InstallVideo_MediaEnded" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2090A0D" Offset="0" />
                    <GradientStop Color="#D9090A0D" Offset="0.55" />
                    <GradientStop Color="#F20A0D15" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#332A2630" BorderThickness="0,0,0,1" Background="#AA090A0D" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <DockPanel Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UPUAUT" Foreground="{StaticResource Sand}" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="  /  OPENER OF THE WAYS" Foreground="#777985" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SETUP · WINDOWS x64" Foreground="#8D8E96" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Button Content="—" Width="36" Padding="4,2" Click="Minimize_Click" />
                        <Button Content="×" Width="36" Padding="4,2" Margin="6,0,0,0" Click="Close_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="44,36,44,34">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,48,0">
                    <Border Width="70" Height="70" CornerRadius="20,5,20,5" BorderBrush="#9A8050" BorderThickness="1" Background="#262115" HorizontalAlignment="Left">
                        <TextBlock Text="&#x1F43A;" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="THE WAYS ARE OPEN" Foreground="{StaticResource Gold}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,27,0,7" />
                    <TextBlock Text="UPUAUT" Foreground="{StaticResource Sand}" FontSize="48" FontWeight="Bold" />
                    <TextBlock Text="Windows System Triage &amp; Network Intelligence" Foreground="#C5C6CB" FontSize="16" Margin="0,4,0,0" />
                    <Border Height="1" Width="260" HorizontalAlignment="Left" Margin="0,24,0,18" Background="#776337" />
                    <TextBlock Text="Scout live traffic. Read the signs in Windows event logs. Bring the hidden path into view." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="22" MaxWidth="390" />
                    <TextBlock x:Name="VersionLabel" Text="VERSION 1.0.0" Foreground="#777985" FontFamily="Consolas" FontSize="10" Margin="0,30,0,0" />
                </StackPanel>

                <Border x:Name="InstallPanel" Grid.Column="1" CornerRadius="10" BorderBrush="#564B35" BorderThickness="1" Background="#E50E1017" Padding="27">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="BEGIN YOUR JOURNEY" Foreground="{StaticResource Sand}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Choose where the instrument will live." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,26,0,0">
                            <TextBlock Text="INSTALL LOCATION" Foreground="{StaticResource Gold}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathBox" Height="38" Padding="10,8" VerticalContentAlignment="Center" Background="#12131A" Foreground="#E5E7EB" BorderBrush="#3C3940" />
                                <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="Browse_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,21,0,0">
                            <TextBlock Text="INSTALLATION PROFILE" Foreground="{StaticResource Gold}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                            <Border Margin="0,9,0,0" Padding="12" BorderBrush="#292B35" BorderThickness="1" Background="#111219">
                                <StackPanel>
                                    <TextBlock Text="For this Windows account" Foreground="#E5E7EB" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="No system-wide changes. A Start Menu shortcut will be created." Foreground="#8D909A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,24,0,18">
                            <ProgressBar x:Name="InstallProgress" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Gold}" Background="#2A2930" Visibility="Collapsed" />
                            <TextBlock x:Name="StatusText" Text="Ready when you are." Foreground="#989BA5" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="By installing, you accept the MIT License." Foreground="#737681" FontSize="10" VerticalAlignment="Center" />
                            <Button x:Name="InstallButton" Grid.Column="1" Content="OPEN THE WAY  ›" MinWidth="156" Padding="17,12" Background="#4B3A18" BorderBrush="#B99847" Foreground="#F3D995" Click="Install_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="UninstallPanel" Grid.Column="1" CornerRadius="10" BorderBrush="#564B35" BorderThickness="1" Background="#E50E1017" Padding="27" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="CLOSE THE BOOK" Foreground="{StaticResource Sand}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Remove Upuaut from this Windows account." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Margin="0,24,0,0" Padding="13" BorderBrush="#292B35" BorderThickness="1" Background="#111219">
                            <StackPanel>
                                <TextBlock Text="APPLICATION FILES" Foreground="{StaticResource Gold}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="InstalledPathLabel" Foreground="#B8BBC4" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <TextBlock Text="The app folder, shortcuts, and Windows uninstall entry will be removed." Foreground="#858893" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="RemoveUserDataCheckBox" Grid.Row="2" VerticalAlignment="Top" Margin="1,20,0,0" Foreground="#E5E7EB" FontSize="11">
                            <StackPanel>
                                <TextBlock Text="Also remove Upuaut diagnostics and crash reports" FontWeight="SemiBold" />
                                <TextBlock Text="Deletes only %LOCALAPPDATA%\Upuaut\Logs and Crashes. Off by default." Foreground="#888B95" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,20,0,18">
                            <ProgressBar x:Name="UninstallProgress" Height="3" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Gold}" Background="#2A2930" Visibility="Collapsed" />
                            <TextBlock x:Name="UninstallStatusText" Text="Your diagnostic data will be kept unless you choose otherwise." Foreground="#989BA5" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="This action cannot be undone." Foreground="#737681" FontSize="10" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="KEEP UPUAUT" Margin="0,0,8,0" Click="CancelUninstall_Click" />
                            <Button x:Name="UninstallButton" Grid.Column="2" Content="REMOVE UPUAUT" MinWidth="144" Padding="14,12" Background="#32191A" BorderBrush="#814044" Foreground="#F0B3B5" Click="Uninstall_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
