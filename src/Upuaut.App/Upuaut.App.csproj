<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\upuaut.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\upuaut.ico" />
    <Resource Include="Assets\upuaut.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Upuaut.Core\Upuaut.Core.csproj" />
    <ProjectReference Include="..\Upuaut.Chronicles\Upuaut.Chronicles.csproj" />
    <ProjectReference Include="..\Upuaut.Scout\Upuaut.Scout.csproj" />
    <ProjectReference Include="..\Upuaut.Weigher\Upuaut.Weigher.csproj" />
    <ProjectReference Include="..\Upuaut.UI\Upuaut.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.1" />
  </ItemGroup>

</Project>
