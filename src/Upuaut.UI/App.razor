@using Microsoft.Extensions.Logging
@inject Microsoft.Extensions.Logging.ILogger<App> Logger

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="exception">
                <div class="app-error-boundary" role="alert">
                    <span>FIELD REPORT // INTERFACE RECOVERY</span>
                    <h2>This view encountered an unexpected error.</h2>
                    <p>Upuaut recorded the diagnostic details in its application logs. You can return to the dashboard or reopen this workspace.</p>
                    <a href="/">RETURN TO DASHBOARD</a>
                </div>
                @{ LogRenderFailure(exception); }
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <div style="padding: 2rem; color: #E6C687;">
                <h2>Path Not Found</h2>
                <p>Upuaut has not opened a way to this location.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private void LogRenderFailure(Exception exception) =>
        Logger.LogError(exception, "Unhandled Blazor component/render failure was contained by the application error boundary");
}
