@inherits LayoutComponentBase
@namespace Upuaut.UI.Shared
@using Upuaut.UI.Components
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject AiSettingsDialogCoordinator AiSettings

<div class="upuaut-shell @(_motionEnabled ? "has-motion-canvas" : "")" @onclick="HandleShellClick">
    <div class="app-background-canvas" aria-hidden="true">
        <div class="app-canvas-poster"></div>
        @if (_motionEnabled)
        {
            <video autoplay muted loop playsinline preload="auto" poster="media/upuaut-splash-poster.jpg">
                <source src="media/upuaut-background.mp4" type="video/mp4" />
            </video>
        }
        <div class="app-motion-shade"></div>
    </div>
    <aside class="upuaut-sidebar">
        <NavMenu />
    </aside>

    <div class="upuaut-main">
        <header class="upuaut-header">
            <div class="header-breadcrumb">
                <span class="gold-accent">✦</span>
                <span class="header-realm">Windows System Telemetry</span>
            </div>

            <!-- ANIMATED HIEROGLYPHIC TITLE STREAM -->
            <div class="header-hieroglyphs-marquee" title="The Sacred Hieroglyphic Alphabet of the Duat (Hover to pause)">
                <div class="hieroglyphs-track">
                    <span class="hieroglyphs-content">@HieroglyphicAlphabetStream</span>
                    <span class="hieroglyphs-content" aria-hidden="true">@HieroglyphicAlphabetStream</span>
                </div>
            </div>

            <div class="header-actions">
                <button class="global-ai-button" @onclick="AiSettings.Open" title="Configure the shared AI provider and encrypted API key">
                    <span class="global-ai-glyph">✧</span><span><strong>AI SERVICES</strong><small>CONFIGURE</small></span>
                </button>

                <button class="badge-chip gold-chip diag-btn" @onclick="ToggleDiagnostics" title="Open App Diagnostics &amp; Logs">
                    <span>⚙️ Diagnostics &amp; Logs</span>
                </button>

                <HelpMenu />

                <button class="motion-toggle @(_motionEnabled ? "motion-on" : "")"
                        @onclick="ToggleMotionAsync"
                        aria-pressed="@_motionEnabled"
                        title="Toggle the animated app canvas">
                    <span class="motion-toggle-glyph">@(_motionEnabled ? "ON" : "OFF")</span>
                    <span><strong>CANVAS MOTION</strong><small>@(_motionEnabled ? "ENABLED" : "REDUCED")</small></span>
                </button>

                <!-- Account & Egyptian Lore Menu Button -->
                <div class="account-menu-wrapper" @onclick:stopPropagation="true">
                    <button class="account-trigger-btn @(_showAccountMenu ? "active" : "")" @onclick="ToggleAccountMenu" title="Architect Profile &amp; The Sacred Pantheon">
                        <span class="account-avatar-mini">AM</span>
                        <span class="account-name-mini">Abhishek Mitra</span>
                        <span class="account-caret">@(_showAccountMenu ? "▲" : "▼")</span>
                    </button>

                    @if (_showAccountMenu)
                    {
                        <div class="account-dropdown-panel animate-fade-in">
                            <!-- Architect Profile Header -->
                            <div class="acc-dropdown-header">
                                <div class="acc-avatar-large">AM</div>
                                <div class="acc-info">
                                    <h3 class="acc-author-name">Abhishek Mitra</h3>
                                    <span class="acc-handle">@("indoctrinatedrecluse")</span>
                                    <span class="acc-role">Creator of Upuaut</span>
                                </div>
                            </div>

                            <!-- Fast Architect Links -->
                            <div class="acc-fast-links">
                                <button class="acc-link-btn" @onclick='@(() => OpenExternalUrl("https://github.com/indoctrinatedrecluse/"))'>
                                    <span>🐙</span> GitHub
                                </button>
                                <button class="acc-link-btn" @onclick='@(() => OpenExternalUrl("https://portfolio-flutter-78bcf.web.app/"))'>
                                    <span>🌐</span> Portfolio
                                </button>
                                <button class="acc-link-btn" @onclick='@(() => OpenExternalUrl("https://github.com/indoctrinatedrecluse/Upuaut"))'>
                                    <span>⭐</span> Upuaut Repo
                                </button>
                            </div>

                            <!-- Egyptian Hieroglyphic Divider -->
                            <div class="acc-hieroglyph-bar">
                                <span>𓇋 𓈖 𓊪 𓅱 ✦ 𓅱 𓊪 𓅱 𓄿 𓅱 𓏏 ✦ 𓌳 𓂝 𓐍 𓏏</span>
                            </div>

                            <!-- The Pantheon & Lore Quick View Section -->
                            <div class="acc-pantheon-section">
                                <div class="acc-section-title-row">
                                    <span class="acc-section-title">THE CELESTIAL PANTHEON</span>
                                    <span class="acc-subsystem-count">7 GUARDIANS</span>
                                </div>
                                <p class="acc-pantheon-intro">
                                    Every diagnostic subsystem in Upuaut is named in reverence of an Egyptian deity guarding the Duat:
                                </p>

                                <div class="acc-deity-list">
                                    <div class="acc-deity-item" @onclick='@(() => NavigateAndClose("scout"))'>
                                        <span class="acc-deity-icon">🐺</span>
                                        <div class="acc-deity-text">
                                            <strong class="acc-deity-name">Upuaut (Wepwawet)</strong>
                                            <span class="acc-deity-desc">Opener of the Ways → The Scout (Wire Sniffer)</span>
                                        </div>
                                    </div>

                                    <div class="acc-deity-item" @onclick='@(() => NavigateAndClose("chronicles"))'>
                                        <span class="acc-deity-icon">📜</span>
                                        <div class="acc-deity-text">
                                            <strong class="acc-deity-name">Thoth (Djehuty)</strong>
                                            <span class="acc-deity-desc">Master of Sacred Words → Chronicles (Logs)</span>
                                        </div>
                                    </div>

                                    <div class="acc-deity-item" @onclick='@(() => NavigateAndClose("weigher"))'>
                                        <span class="acc-deity-icon">⚖️</span>
                                        <div class="acc-deity-text">
                                            <strong class="acc-deity-name">Ma'at</strong>
                                    <span class="acc-deity-desc">The Feather of Truth → The Scales (Correlation Preview)</span>
                                        </div>
                                    </div>

                                    <div class="acc-deity-item" @onclick='@(() => NavigateAndClose("crash-forensics"))'>
                                        <span class="acc-deity-icon">🛡️</span>
                                        <div class="acc-deity-text">
                                            <strong class="acc-deity-name">Anpu (Anubis)</strong>
                                            <span class="acc-deity-desc">Guardian of the Vessel → Crash Forensics</span>
                                        </div>
                                    </div>

                                    <div class="acc-deity-item" @onclick='@(() => NavigateAndClose("docs"))'>
                                        <span class="acc-deity-icon">📖</span>
                                        <div class="acc-deity-text">
                                            <strong class="acc-deity-name">Seshat</strong>
                                            <span class="acc-deity-desc">Mistress of Books → Documentation Engine</span>
                                        </div>
                                    </div>

                                    <div class="acc-deity-item" @onclick='@(() => NavigateAndClose("pantheon"))'>
                                        <span class="acc-deity-icon">💧</span>
                                        <div class="acc-deity-text">
                                            <strong class="acc-deity-name">Kebechet</strong>
                                            <span class="acc-deity-desc">Lady of Cold Water → Noise Suppression</span>
                                        </div>
                                    </div>

                                    <div class="acc-deity-item" @onclick='@(() => NavigateAndClose("pantheon"))'>
                                        <span class="acc-deity-icon">⚡</span>
                                        <div class="acc-deity-text">
                                            <strong class="acc-deity-name">Seker</strong>
                                            <span class="acc-deity-desc">Restorer of the Broken → Evidence-based Guidance</span>
                                        </div>
                                    </div>
                                </div>

                                <button class="acc-pantheon-btn" @onclick='@(() => NavigateAndClose("pantheon"))'>
                                    <span>📜 Explore Full Pantheon &amp; Lore Portal</span>
                                    <span>→</span>
                                </button>
                            </div>

                            <!-- Footer Navigation Links -->
                            <div class="acc-dropdown-footer">
                                <button class="acc-footer-nav" @onclick='@(() => NavigateAndClose("docs"))'>
                                    <span>📖 System Documentation</span>
                                </button>
                                <button class="acc-footer-nav" @onclick='@(() => NavigateAndClose("about"))'>
                                    <span>🏛️ About the Architect &amp; Specs</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        <main class="upuaut-content">
            @Body
        </main>
    </div>
</div>

<UpdateDialogHost />
<AiSettingsDialogHost />

@if (_showSplash)
{
    <div class="upuaut-launch-splash" role="dialog" aria-modal="true" aria-labelledby="splash-title">
        <div class="splash-sigil">&#x1F43A;</div>
        <div class="splash-kicker">THE DUAT GATEWAY // SYSTEMS PREPARATION</div>
        <h1 id="splash-title">UPUAUT</h1>
        <p>Windows System Triage &amp; Network Intelligence</p>
        <div class="splash-boot-sequence" aria-live="polite">
            <span><i></i> Reading the signs of the system <b>READY</b></span>
            <span><i></i> Preparing the Chronicles and Scout <b>READY</b></span>
            <span><i></i> Opening the ways into the Duat <b>AWAITING ENTRY</b></span>
        </div>
        <div class="splash-progress"><span></span></div>
        <button class="splash-enter" @onclick="EnterApp">ENTER THE APP <span aria-hidden="true">→</span></button>
        <small class="splash-footnote">Your workspaces are prepared. Enter when you are ready.</small>
    </div>
}

<DiagnosticsDrawer @bind-IsOpen="_showDiagnostics" />

<FluentProviders />

@code {
    private bool _showDiagnostics;
    private bool _showAccountMenu;
    private bool _motionEnabled;
    private bool _showSplash = true;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;
        try
        {
            _motionEnabled = await JSRuntime.InvokeAsync<bool>("upuautMotion.getEnabled");
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _motionEnabled = false;
        }
    }

    private async Task ToggleMotionAsync()
    {
        _motionEnabled = !_motionEnabled;
        try { await JSRuntime.InvokeVoidAsync("upuautMotion.setEnabled", _motionEnabled); }
        catch { }
    }

    private void EnterApp() => _showSplash = false;

    private const string HieroglyphicAlphabetStream =
        "𓄿 𓇋 𓇌 𓂝 𓅱 𓃀 𓊪 𓆑 𓅓 𓈖 𓂋 𓉔 𓎛 𓐍 𓄡 𓊃 𓋴 𓈙 𓈎 𓎡 𓎼 𓏏 𓍿 𓂧 𓆓 " +
        "✦ 𓅱 𓊪 𓅱 𓄿 𓅱 𓏏 ✦ 𓅓 𓂝 𓅱 𓅱 𓏛 ✦ 𓌳 𓂝 𓐍 𓏏 𓆄 ✦ 𓇋 𓈖 𓊪 𓅱 𓃣 ✦ 𓋴 𓈙 𓏏 𓏛 ✦ 𓈎 𓃀 𓎛 𓏏 ✦ 𓊃 𓎡 𓂋 𓅓 " +
        "✦ 𓋹 𓊹 𓊽 𓁹 𓇳 𓇽 ✦ ";

    private void ToggleDiagnostics()
    {
        _showDiagnostics = !_showDiagnostics;
        if (_showDiagnostics)
        {
            _showAccountMenu = false;
        }
    }

    private void ToggleAccountMenu()
    {
        _showAccountMenu = !_showAccountMenu;
    }

    private void HandleShellClick()
    {
        if (_showAccountMenu)
        {
            _showAccountMenu = false;
        }
    }

    private void NavigateAndClose(string route)
    {
        _showAccountMenu = false;
        NavManager.NavigateTo(route);
    }

    private void OpenExternalUrl(string url)
    {
        try
        {
            if (OperatingSystem.IsWindows())
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = url,
                    UseShellExecute = true
                });
            }
        }
        catch
        {
            // Suppress fallback
        }
    }
}
