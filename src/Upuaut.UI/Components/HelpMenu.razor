@namespace Upuaut.UI.Components
@using Microsoft.Extensions.Logging
@inject NavigationManager Navigation
@inject Upuaut.Core.Updates.IUpdateService UpdateService
@inject Microsoft.Extensions.Logging.ILogger<HelpMenu> Logger

<div class="help-menu" @onclick:stopPropagation="true">
    <button class="help-menu-trigger" aria-haspopup="menu" aria-expanded="@_menuOpen" @onclick="ToggleMenu">
        <span aria-hidden="true">?</span> HELP <span class="help-caret">@(_menuOpen ? "▲" : "▼")</span>
    </button>
    @if (_menuOpen)
    {
        <div class="help-menu-panel" role="menu">
            <span class="help-menu-label">UPUAUT REFERENCE</span>
            <button role="menuitem" @onclick="OpenUpdates"><span>↻</span><span><strong>Check for Updates</strong><small>Compare with the latest release</small></span></button>
            <button role="menuitem" @onclick="OpenDocumentation"><span>⌕</span><span><strong>Documentation</strong><small>Search feature guides and workflows</small></span></button>
            <button role="menuitem" @onclick="OpenAbout"><span>✦</span><span><strong>About Upuaut</strong><small>App details and author links</small></span></button>
        </div>
    }
</div>

@if (_showDocumentation)
{
    <div class="help-modal-backdrop" @onclick="CloseDialogs">
        <section class="help-modal-panel documentation-modal" role="dialog" aria-modal="true" aria-labelledby="help-doc-title" @onclick:stopPropagation="true">
            <header class="help-modal-header">
                <div><span class="help-menu-label">FIELD GUIDE · SESHTATU</span><h2 id="help-doc-title">Upuaut Documentation</h2></div>
                <button class="help-modal-close" aria-label="Close documentation" @onclick="CloseDialogs">×</button>
            </header>
            <p class="help-modal-intro">Search practical steps for investigating Windows events and inspecting network traffic.</p>
            <div class="help-doc-search">
                <span aria-hidden="true">⌕</span>
                <input type="search" placeholder="Search: event logs, DNS, Npcap, permissions…" @bind="_query" @bind:event="oninput" aria-label="Search documentation" />
                @if (!string.IsNullOrWhiteSpace(_query))
                {
                    <button aria-label="Clear search" @onclick='() => _query = ""'>×</button>
                }
            </div>
            <div class="help-doc-results" aria-live="polite">
                @if (!VisibleTopics.Any())
                {
                    <div class="help-doc-empty"><strong>No matching guide</strong><span>Try a feature name such as “Scout”, “Chronicles”, or “Npcap”.</span></div>
                }
                @foreach (var topic in VisibleTopics)
                {
                    <article class="help-doc-topic">
                        <span class="help-topic-category">@topic.Category</span>
                        <h3>@topic.Title</h3>
                        <p>@topic.Intro</p>
                        <ol>
                            @foreach (var step in topic.Steps)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    </article>
                }
            </div>
            <footer class="help-modal-footer">
                <span>More technical detail and project structure are available in the full reference.</span>
                <button class="help-modal-secondary" @onclick="OpenFullReference">Open full documentation →</button>
            </footer>
        </section>
    </div>
}

@if (_showAbout)
{
    <div class="help-modal-backdrop" @onclick="CloseDialogs">
        <section class="help-modal-panel about-modal" role="dialog" aria-modal="true" aria-labelledby="help-about-title" @onclick:stopPropagation="true">
            <button class="help-modal-close about-close" aria-label="Close About" @onclick="CloseDialogs">×</button>
            <AboutContent />
        </section>
    </div>
}

@if (_showUpdates)
{
    <div class="help-modal-backdrop" @onclick="CloseUpdates">
        <section class="help-modal-panel update-modal" role="dialog" aria-modal="true" aria-labelledby="update-title" @onclick:stopPropagation="true">
            <header class="help-modal-header">
                <div><span class="help-modal-kicker">UPUAUT RELEASE CHANNEL</span><h2 id="update-title">Check for Updates</h2></div>
                <button class="help-modal-close" aria-label="Close updates" @onclick="CloseUpdates">×</button>
            </header>
            <p class="update-status">@_updateMessage</p>
            @if (_updateRelease is { } release)
            {
                <div class="update-release-card">
                    <span class="help-topic-category">NEW RELEASE · v@release.Version</span>
                    <h3>@release.Name</h3>
                    @if (!string.IsNullOrWhiteSpace(release.Notes))
                    {
                        <p>@release.Notes</p>
                    }
                </div>
            }
            @if (_updateBusy)
            {
                <div class="update-progress-track"><div style="width:@($"{_updateProgress:0}%")"></div></div>
                <small class="update-progress-label">@(_updateProgress > 0 ? $"DOWNLOADING · {_updateProgress:0}%" : "CONTACTING RELEASE CHANNEL…")</small>
            }
            <footer class="help-modal-footer">
                <span>Updates are downloaded from the official Upuaut GitHub releases.</span>
                @if (_updateRelease is not null && !_updateBusy)
                {
                    <button class="update-install-button" @onclick="DownloadAndInstall">DOWNLOAD &amp; INSTALL</button>
                }
                else if (!_updateBusy)
                {
                    <button class="help-modal-secondary" @onclick="CheckForUpdates">CHECK AGAIN</button>
                }
            </footer>
        </section>
    </div>
}

@code {
    private bool _menuOpen;
    private bool _showDocumentation;
    private bool _showAbout;
    private bool _showUpdates;
    private bool _updateBusy;
    private double _updateProgress;
    private Upuaut.Core.Updates.UpdateRelease? _updateRelease;
    private string _updateMessage = "Compare this installation with the latest stable release.";
    private string _query = "";

    private IEnumerable<HelpTopic> VisibleTopics => string.IsNullOrWhiteSpace(_query)
        ? _topics
        : _topics.Where(topic =>
            topic.Title.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            topic.Category.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            topic.Intro.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            topic.Steps.Any(step => step.Contains(_query, StringComparison.OrdinalIgnoreCase)));

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ = CheckForStartupUpdate();
        return Task.CompletedTask;
    }

    private async Task CheckForStartupUpdate()
    {
        try
        {
            var release = await UpdateService.CheckForUpdateAsync();
            if (release is not null)
            {
                _updateRelease = release;
                _updateMessage = $"Upuaut v{release.Version} is ready. Review the release notes, then choose whether to download and install it.";
                _showUpdates = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Automatic update check failed during startup"); }
    }

    private async Task OpenUpdates()
    {
        _menuOpen = false;
        _showUpdates = true;
        await CheckForUpdates();
    }

    private async Task CheckForUpdates()
    {
        _updateBusy = true;
        _updateRelease = null;
        _updateMessage = "Contacting the release channel…";
        try
        {
            _updateRelease = await UpdateService.CheckForUpdateAsync();
            _updateMessage = _updateRelease is null
                ? "This installation is up to date. The path is clear."
                : $"Upuaut v{_updateRelease.Version} is available. Review the release notes, then choose whether to download and install it.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Manual update check failed");
            _updateMessage = $"The release channel could not be reached: {ex.Message}";
        }
        finally { _updateBusy = false; }
    }

    private async Task DownloadAndInstall()
    {
        if (_updateRelease is not { } release) return;
        _updateBusy = true;
        _updateProgress = 0;
        _updateMessage = "Downloading and verifying the setup bundle. The installer will open when staging is complete.";
        try
        {
            var progress = new Progress<double>(value => { _updateProgress = value; _ = InvokeAsync(StateHasChanged); });
            await UpdateService.DownloadAndLaunchInstallerAsync(release, progress);
            _updateMessage = "Setup is ready. Upuaut is closing so the installer can update its files.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not download or launch update v{Version}", release.Version);
            _updateMessage = $"Update could not be staged: {ex.Message}";
            _updateBusy = false;
        }
    }

    private void CloseUpdates() { if (!_updateBusy) _showUpdates = false; }

    private void OpenDocumentation()
    {
        _menuOpen = false;
        _query = "";
        _showDocumentation = true;
    }

    private void OpenAbout()
    {
        _menuOpen = false;
        _showAbout = true;
    }

    private void CloseDialogs()
    {
        _showDocumentation = false;
        _showAbout = false;
    }

    private void OpenFullReference()
    {
        CloseDialogs();
        Navigation.NavigateTo("docs");
    }

    private sealed record HelpTopic(string Category, string Title, string Intro, string[] Steps);

    private readonly HelpTopic[] _topics =
    [
        new("GETTING STARTED", "Choose a workspace", "The dashboard is the launch point for Upuaut’s available tools.",
        ["Open Chronicles to query local Windows event logs or load an exported .evtx file.", "Open Scout to inspect live network traffic. Choose a capture mode and adapter before starting.", "Use the Scales (Triage) entry to compare recent events with packets already in Scout’s buffer."]),
        new("CHRONICLES · EVENT LOGS", "Investigate Windows events", "Chronicles filters event records and helps group related failures.",
        ["Choose a channel such as System or Application and a time range, then select Query Logs.", "Narrow the results by severity, provider, or text; use a Quick Triage preset for common crash, network, storage, or security issues.", "Select an event to inspect its details. Switch to Failure Clusters to group similar events, or use Export Triage Report to save the current findings.", "To inspect a saved log, select Load .evtx and enter the full path to the file."]),
        new("SCOUT · PACKET CAPTURE", "Capture and inspect traffic", "Scout offers native IPv4 capture and optional Ethernet capture through Npcap.",
        ["Select Native IPv4 for driver-free capture, or Ethernet frames when Npcap is installed. Select the adapter before starting.", "Native IPv4 raw-socket capture needs elevated permissions. Ethernet capture needs Npcap and may also require elevation depending on the adapter and driver setup.", "Select Start Capture, then filter by protocol, process, IP address, port, domain, or payload. Select a row to inspect frame details and bytes.", "Select Stop Capture to end the session. Clear removes the current in-memory packet buffer."]),
        new("SCOUT · TROUBLESHOOTING", "If packets are missing", "Capture visibility depends on the selected interface, mode, privileges, and protocol support.",
        ["Check that the chosen adapter is active and is the interface carrying the traffic.", "For Native IPv4, restart Upuaut with administrator privileges if Windows denies raw-socket capture.", "For Ethernet mode, install Npcap and confirm its capture service is running; Ethernet mode dissects IPv4, IPv6, ARP, TCP, UDP, ICMP, and ICMPv6.", "Process attribution can be unavailable for packets that do not match a current local TCP/UDP socket."]),
        new("DISPLAY & PERFORMANCE", "Adjust the app canvas", "The animated background can be disabled for reduced motion or slower computers.",
        ["Use the prominent Canvas Motion switch in the top bar to enable or disable the animated app canvas. The static poster remains as the background, and the launch splash still appears at startup.", "Open Diagnostics & Logs from the top bar when you need application logs or crash-reporting information."]),
        new("UPDATES", "Install a new Upuaut release", "Upuaut checks the latest stable GitHub release at startup and lets you decide when to install.",
        ["If an update is found, review its release notes in the update window. You can also open Help and choose Check for Updates at any time.", "Choose Download & Install to stage the official Windows setup bundle. The themed setup program opens and Upuaut closes so its files can be updated.", "The installer updates the current per-user installation. Keep the setup window open until installation completes."]),
        new("TRIAGE · EARLY PREVIEW", "Compare events with nearby packets", "The Scales can query recent System/Application warnings and errors and compare them with packets already in Scout’s buffer.",
        ["Choose event channels and a time window, then select Analyze Available Signals. This does not start packet capture.", "An event is paired with its nearest buffered packet when their timestamps are within 2.5 seconds.", "The display indicates temporal proximity only. It does not determine that a packet caused an event; weighted anomaly scoring is not implemented yet."])
    ];
}
