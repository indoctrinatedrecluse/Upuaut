@page "/"
@namespace Upuaut.UI.Pages
@using Upuaut.Core.Interfaces
@using Upuaut.Scout.Services
@inject NavigationManager Nav
@inject ScoutManager ScoutService
@inject IChroniclesService ChroniclesService

<PageTitle>Upuaut — Overview</PageTitle>

<div class="page-container">
    <div class="page-hero" style="margin-bottom: 2rem;">
        <h1 class="page-title" style="margin: 0; font-size: 1.85rem; color: var(--upuaut-sand); display: flex; align-items: center; gap: 0.5rem;">
            <span class="gold-accent">✦</span> Opener of the Ways
        </h1>
        <p class="page-subtitle" style="color: var(--upuaut-text-muted); font-size: 0.95rem; margin-top: 0.5rem; max-width: 750px;">
            Windows event-log investigation, network packet inspection, and signal triage.
        </p>
    </div>

    <AiProfileBanner />

    <div class="card-grid">
        <div class="diag-card" style="cursor: pointer;" @onclick='@(() => NavigateTo("chronicles"))' title="Click to view Windows Event Logs">
            <div class="diag-card-header">
                <span class="diag-card-title">Event Log Status</span>
                <FluentIcon Value="@(new Icons.Regular.Size20.DocumentBulletListMultiple())" />
            </div>
            <div class="diag-card-value">Ready</div>
            <div class="diag-card-sub">Windows channels and offline .evtx files</div>
        </div>

        <div class="diag-card" style="cursor: pointer;" @onclick='@(() => NavigateTo("scout"))' title="Click to view Packet Sniffer">
            <div class="diag-card-header">
                <span class="diag-card-title">Network Sniffer</span>
                <FluentIcon Value="@(new Icons.Regular.Size20.Radar())" />
            </div>
            <div class="diag-card-value @(ScoutService.IsCapturing ? "text-green" : "")">
                @(ScoutService.IsCapturing ? "Capturing Active" : "Standby")
            </div>
            <div class="diag-card-sub">
                @(ScoutService.BufferCount > 0 ? $"{ScoutService.BufferCount} packets buffered" : "Socket-to-Process correlation ready")
            </div>
        </div>

        <div class="diag-card triage-preview-card" style="cursor: pointer;" @onclick='@(() => NavigateTo("weigher"))' title="Open the Scales correlation preview">
            <div class="diag-card-header">
                <span class="diag-card-title">The Scales · Triage</span>
                <FluentIcon Value="@(new Icons.Regular.Size20.Scales())" />
            </div>
            <div class="diag-card-value">Correlation preview</div>
            <div class="diag-card-sub">Compare nearby event and packet signals</div>
        </div>

    </div>

    <div class="dashboard-sections" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
        <FluentCard Style="background-color: var(--upuaut-surface); border: 1px solid var(--upuaut-border); padding: 1.5rem;">
            <h3 style="color: var(--upuaut-sand); margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span>📜</span> The Duat Chronicles — Event Log Forensic Triage
            </h3>
            <p style="color: var(--upuaut-text-muted); font-size: 0.9rem;">
                Triage local Windows Event Logs, inspect BSOD stop codes, decode memory access violations, and group repetitive error bursts into distinct anomaly failure signatures.
            </p>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick='@(() => NavigateTo("chronicles"))'>
                Open Chronicles
            </FluentButton>
        </FluentCard>

        <FluentCard Style="background-color: var(--upuaut-surface); border: 1px solid var(--upuaut-border); padding: 1.5rem;">
            <h3 style="color: var(--upuaut-sand); margin-top: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span>🐺</span> The Scout — Live Packet Sniffer &amp; Process Attribution
            </h3>
            <p style="color: var(--upuaut-text-muted); font-size: 0.9rem;">
                Capture IPv4 with native Windows Raw Sockets or Ethernet frames with Npcap. Process attribution is best effort and depends on a current local socket match.
            </p>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick='@(() => NavigateTo("scout"))'>
                Deploy Scout
            </FluentButton>
        </FluentCard>
    </div>
</div>

@code {
    private void NavigateTo(string path)
    {
        Nav.NavigateTo(path);
    }
}
