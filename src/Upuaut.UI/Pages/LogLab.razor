    private static string FormatLabel(LogDocument document)
    {
        var contentType = document.Format switch
        {
            LogDocumentFormat.PlainText => "plain text",
            LogDocumentFormat.JsonLines => "JSON Lines",
            LogDocumentFormat.WindowsEventXml => "Windows Event XML",
            LogDocumentFormat.WebAccess => "web access",
            LogDocumentFormat.KeyValue => "key/value",
            LogDocumentFormat.CustomProfile => "custom profile",
            _ => document.Format.ToString().ToUpperInvariant()
        };
        if (document.FileExtension.Length <= 1) return $"{contentType} log file (no extension)";
        var parserNote = document.ContentKind switch
        {
            LogContentKind.BinaryLike => " · binary-like raw preview",
            LogContentKind.MixedTextAndBinary => $" · mostly readable; parsed as {contentType}",
            _ => document.Format == LogDocumentFormat.PlainText ? " · plain-text inspection" : $" · parsed as {contentType}"
        };
        return document.FileTypeLabel + parserNote;
    }
    private LogEntryAnalysis AnalysisFor(ParsedLogEntry entry) => _analysis?.Entries.GetValueOrDefault(entry.Index) ?? new LogEntryAnalysis(entry.Index, LogScenarioCategory.Unclassified, "Analysis pending", "", RuleMatchStrength.NoRuleMatched, [], [], []);
    private bool MatchesAnalysis(ParsedLogEntry entry, string query)
    {
        var finding = AnalysisFor(entry);
        return entry.Message.Contains(query, StringComparison.OrdinalIgnoreCase) || entry.RawText.Contains(query, StringComparison.OrdinalIgnoreCase) ||
            entry.Fields.Any(field => field.Key.Contains(query, StringComparison.OrdinalIgnoreCase) || field.Value.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            finding.Headline.Contains(query, StringComparison.OrdinalIgnoreCase) || finding.Category.ToString().Contains(query, StringComparison.OrdinalIgnoreCase) ||
            finding.Tags.Any(tag => tag.Contains(query, StringComparison.OrdinalIgnoreCase)) || finding.Explanation.Contains(query, StringComparison.OrdinalIgnoreCase) ||
            finding.Recommendations.Any(recommendation => recommendation.Contains(query, StringComparison.OrdinalIgnoreCase)) ||
            finding.Evidence.Any(evidence => evidence.Field.Contains(query, StringComparison.OrdinalIgnoreCase) || evidence.Value.Contains(query, StringComparison.OrdinalIgnoreCase));
    }
    private string HighlightMatches(string text)
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return System.Net.WebUtility.HtmlEncode(text);
        var safeText = System.Net.WebUtility.HtmlEncode(text);
        var safeQuery = System.Net.WebUtility.HtmlEncode(_searchQuery.Trim());
        if (safeQuery.Length == 0) return safeText;
        return System.Text.RegularExpressions.Regex.Replace(safeText, System.Text.RegularExpressions.Regex.Escape(safeQuery), match => $"<mark class=\"log-search-hit\">{match.Value}</mark>", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant, TimeSpan.FromMilliseconds(100));
    }
    private void SetCategoryFilter(LogScenarioCategory category) => _categoryFilter = _categoryFilter == category.ToString() ? string.Empty : category.ToString();
    private async Task AnalyzeCurrentDocumentAsync()
    {
        if (_document is null) return;
        var doc = _document;
        try
        {
            (_analysis, _sequenceFindings, _timeline) = await Task.Run(() =>
            {
                var analysis = AnalysisEngine.Analyze(doc);
                var sequences = SequenceAnalysisEngine.Analyze(doc, new LogSequenceAnalysisOptions(_sequenceWindowMinutes, _sameComponentOnly));
                var timeline = TimelineAnalysisEngine.Analyze(doc, _timelineIntervalMinutes);
                return (analysis, sequences, timeline);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Log Lab analysis failed for {FileName}; preserving source in raw editor mode", doc.FileName);
            _analysis = null; _sequenceFindings = []; _timeline = null;
            _showWholeDocument = true; _selectedEntry = null; _editorText = doc.OriginalText;
            _statusMessage = "Structured analysis could not complete. The original source remains available in raw editor mode.";
            _isError = true;
        }
        _filteredDocument = null;
    }

    private async Task RefreshSequences()
    {
        if (_document is null) return;
        var document = _document;
        _selectedSequence = null;
        try { _sequenceFindings = await Task.Run(() => SequenceAnalysisEngine.Analyze(document, new LogSequenceAnalysisOptions(_sequenceWindowMinutes, _sameComponentOnly))); }
        catch (Exception ex) { Logger.LogError(ex, "Log Lab sequence analysis failed for {FileName}", document.FileName); _sequenceFindings = []; _statusMessage = "Sequence analysis failed; parsed entries remain available. Check the application log for details."; _isError = true; }
    }

    private async Task RefreshTimeline()
    {
        if (_document is null) return;
        var document = _document;
        _activeTimelineBucket = null;
        try { _timeline = await Task.Run(() => TimelineAnalysisEngine.Analyze(document, _timelineIntervalMinutes)); }
        catch (Exception ex) { Logger.LogError(ex, "Log Lab timeline analysis failed for {FileName}", document.FileName); _timeline = null; _statusMessage = "Timeline analysis failed; parsed entries remain available. Check the application log for details."; _isError = true; }
    }

    private void FilterTimelineBucket(LogTimelineBucket bucket)
    {
        _activeTimelineBucket = bucket.StartUtc;
        _fromLocal = bucket.StartUtc.ToLocalTime().DateTime;
        _toLocal = bucket.EndUtc.AddTicks(-1).ToLocalTime().DateTime;
        _entryLimit = 500;
        _filteredDocument = null;
    }

    private static int TimelineErrorHeight(LogTimelineBucket bucket) => bucket.TotalCount == 0 ? 0 : (int)Math.Round(bucket.ErrorCount * 100d / bucket.TotalCount);
    private static string TimelineTooltip(LogTimelineBucket bucket) => $"{bucket.StartUtc:yyyy-MM-dd HH:mm} UTC · {bucket.TotalCount} entries · {bucket.WarningCount} warnings · {bucket.ErrorCount} errors";

    private void SaveSearchPreset()
    {
        try
        {
            var preset = new LogSearchPreset(_presetName, _searchQuery, _severityFilter, _categoryFilter, _componentFilter, _fromLocal?.ToString("O", CultureInfo.InvariantCulture) ?? string.Empty, _toLocal?.ToString("O", CultureInfo.InvariantCulture) ?? string.Empty);
            SearchPresetService.Save(preset); _searchPresets = SearchPresetService.Load(); _selectedPresetName = preset.Name.Trim();
            _statusMessage = $"Saved Log Lab filter '{_selectedPresetName}' to this Windows account."; _isError = false;
        }
        catch (Exception ex) { _statusMessage = $"Could not save filter: {ex.Message}"; _isError = true; }
    }

    private void ApplySearchPreset()
    {
        var preset = _searchPresets.FirstOrDefault(item => item.Name == _selectedPresetName);
        if (preset is null) { _statusMessage = "Choose a saved filter first."; _isError = true; return; }
        _searchQuery = preset.Query; _severityFilter = preset.Severity; _categoryFilter = preset.Category;
        _componentFilter = preset.ComponentContains; _fromLocal = ParsePresetDate(preset.FromLocal); _toLocal = ParsePresetDate(preset.ToLocal);
        _presetName = preset.Name; _entryLimit = 500; _filteredDocument = null;
        _statusMessage = $"Applied saved filter '{preset.Name}'. Conditions are combined."; _isError = false;
    }

