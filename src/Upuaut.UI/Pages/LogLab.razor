        CrashHandoff.Set(new CrashLogContext(_document?.FileName ?? "Imported log", _document?.SourcePath ?? string.Empty,
            entry.SourceLine, entry.Timestamp, entry.Severity.ToString(), finding.Headline, finding.Explanation, entry.RawText));
        Navigation.NavigateTo("crash-forensics");
