    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_document is null) return;
        try
        {
            if (!_editorScrollSyncAttached)
            {
                await JS.InvokeVoidAsync("upuautLogEditor.attachHighlightSync", _editorRef);
                _editorScrollSyncAttached = true;
            }
            if (_lastRenderedSyntaxOverlay != _syntaxOverlayEnabled || _lastRenderedEditorWrap != _wrapEditor)
            {
                await JS.InvokeVoidAsync("upuautLogEditor.syncHighlight", _editorRef);
                _lastRenderedSyntaxOverlay = _syntaxOverlayEnabled;
                _lastRenderedEditorWrap = _wrapEditor;
            }
            if (_resetEditorScrollAfterRender)
            {
                await JS.InvokeVoidAsync("upuautLogEditor.resetScroll", _editorRef);
                _resetEditorScrollAfterRender = false;
            }
        }
        catch (Exception ex) { Logger.LogDebug(ex, "Log Lab editor scroll synchronization could not attach"); }
    }

