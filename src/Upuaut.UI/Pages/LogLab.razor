    private void SaveReport(string extension, string filter, Func<string> contentFactory)
    {
        if (_document is null || _analysis is null) { _statusMessage = "Import a log before creating a report."; _isError = true; return; }
        var dialog = new SaveFileDialog { Title = "Save Log Lab investigation report", Filter = filter, FileName = Path.GetFileNameWithoutExtension(_document.FileName) + $"-upuaut-report.{extension}", AddExtension = true, DefaultExt = extension };
        if (dialog.ShowDialog() != true) return;
        try { File.WriteAllText(dialog.FileName, contentFactory()); _statusMessage = $"Saved report to {dialog.FileName}. Review log content before sharing."; _isError = false; }
        catch (Exception ex) { _statusMessage = $"Could not save report: {ex.Message}"; _isError = true; }
    }
    private static string FormatBytes(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / (1024d * 1024d):0.#} MB" : $"{bytes / 1024d:0.#} KB";
    private static string SeverityClass(LogEntrySeverity severity) => severity switch { LogEntrySeverity.Critical or LogEntrySeverity.Error => "is-error", LogEntrySeverity.Warning => "is-warning", LogEntrySeverity.Success => "is-success", LogEntrySeverity.Information => "is-info", _ => "is-unknown" };
    private IReadOnlyList<ParsedLogEntry> SelectedSequenceEntries => _document is null || _selectedSequence is null ? [] : _selectedSequence.EntryIndices.Take(2).Select(index => _document.Entries.FirstOrDefault(entry => entry.Index == index)).Where(entry => entry is not null).Cast<ParsedLogEntry>().ToArray();
}
