    private void MarkEditorDirty() => _editorDirty = true;
    private async Task FindInEditor(bool backwards)
    {
        if (_editorFind.Length == 0) { _editorStatus = "Enter text to find."; return; }
        if (_editorText.Length == 0) { _editorStatus = "This editor view is empty."; return; }
        var startAt = backwards ? Math.Clamp(_editorFindPosition - _editorFind.Length - 1, 0, Math.Max(0, _editorText.Length - 1)) : Math.Min(_editorText.Length, _editorFindPosition);
        var found = backwards ? _editorText.LastIndexOf(_editorFind, startAt, StringComparison.OrdinalIgnoreCase) : _editorText.IndexOf(_editorFind, startAt, StringComparison.OrdinalIgnoreCase);
        if (found < 0 && !backwards) found = _editorText.IndexOf(_editorFind, StringComparison.OrdinalIgnoreCase);
        if (found < 0 && backwards && _editorText.Length > 0) found = _editorText.LastIndexOf(_editorFind, StringComparison.OrdinalIgnoreCase);
        if (found < 0) { _editorStatus = "No match in this editor view."; return; }
        _editorFindPosition = found + _editorFind.Length;
        var line = _editorText.AsSpan(0, found).Count('\n') + 1;
        _editorStatus = $"Match at line {line:N0}.";
        await JS.InvokeVoidAsync("upuautLogEditor.selectRange", _editorRef, found, _editorFind.Length);
    }
    private void ReplaceCurrent()
    {
        if (_editorFind.Length == 0) return;
        var start = Math.Max(0, Math.Min(_editorFindPosition - _editorFind.Length, _editorText.Length));
        if (start + _editorFind.Length > _editorText.Length || !_editorText.AsSpan(start, _editorFind.Length).Equals(_editorFind, StringComparison.OrdinalIgnoreCase)) { _editorStatus = "Find a match before replacing."; return; }
        _editorText = _editorText[..start] + _editorReplace + _editorText[(start + _editorFind.Length)..]; _editorDirty = true; _editorFindPosition = start; _editorStatus = "Replaced one match.";
    }
    private void ReplaceAll()
    {
        if (_editorFind.Length == 0) return;
        var count = 0; var cursor = 0;
        while ((cursor = _editorText.IndexOf(_editorFind, cursor, StringComparison.OrdinalIgnoreCase)) >= 0) { count++; cursor += _editorFind.Length; }
        _editorText = _editorText.Replace(_editorFind, _editorReplace, StringComparison.OrdinalIgnoreCase); _editorDirty |= count > 0; _editorStatus = $"Replaced {count:N0} match(es)."; _editorFindPosition = 0;
    }
