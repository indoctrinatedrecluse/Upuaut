    {
        _searchQuery = string.Empty; _severityFilter = string.Empty; _categoryFilter = string.Empty;
        _componentFilter = string.Empty; _fromLocal = null; _toLocal = null; _activeTimelineBucket = null;
        _entryLimit = 500; _filteredDocument = null;
    }

    private void DeleteSearchPreset()
    {
        if (string.IsNullOrWhiteSpace(_selectedPresetName)) { _statusMessage = "Choose a saved filter to delete."; _isError = true; return; }
