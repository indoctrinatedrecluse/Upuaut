@page "/log-lab"
@namespace Upuaut.UI.Pages
@using Microsoft.Win32
@using Upuaut.LogLab
@using Upuaut.LogLab.Models
@using Upuaut.CrashForensics
@using Upuaut.CrashForensics.Models
@using System.Globalization
@using Microsoft.Extensions.Logging
@using Upuaut.Core.AI
@using Upuaut.UI.Components
@inject ILogParsingEngine ParsingEngine
@inject ILogAnalysisEngine AnalysisEngine
@inject ILogSequenceAnalysisEngine SequenceAnalysisEngine
@inject ILogReportExporter ReportExporter
@inject ILogParserProfileService ProfileService
@inject ILogTimelineAnalysisEngine TimelineAnalysisEngine
@inject ILogSearchPresetService SearchPresetService
@inject CrashForensicsHandoff CrashHandoff
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<LogLab> Logger
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Upuaut — General-purpose Log Lab</PageTitle>

<div class="log-lab-page">
    <header class="log-lab-header">
        <div>
            <div class="log-lab-eyebrow"><span></span> UPUAUT // MULTIFORMAT LOG ANALYSIS</div>
            <h1>General-purpose <span>Log Lab</span></h1>
            <p>Import a log, inspect extracted fields, and review evidence-backed scenario signals and suggested investigative checks.</p>
        </div>
        <button class="log-lab-import" @onclick="ImportFile">IMPORT LOG FILE <span>↗</span></button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="log-lab-status @(_isError ? "is-error" : "")" role="status">@_statusMessage</div>
    }

    <AiProfileBanner />

    @if (_document is null)
    {
        <section class="log-lab-empty">
            <div class="log-lab-empty-glyph">⌘</div>
            <span class="log-lab-eyebrow">PHASE 5 // INVESTIGATION WORKBENCH</span>
            <h2>Bring a log into the Lab</h2>
            <p>Import text, structured logs, hex dumps, solution files, or other files whose contents are mostly readable. Upuaut keeps the original intact and builds a separate, best-effort view of entries and fields.</p>
            <div class="log-lab-format-list"><span>TEXT / LOG</span><span>JSON / JSONL</span><span>XML / EVENT XML</span><span>CSV</span><span>INI / LOGFMT</span><span>SYSLOG / ACCESS LOG</span><span>UP TO 32 MB</span></div>
            <button class="log-lab-import secondary" @onclick="ImportFile">SELECT A FILE</button>
        </section>
    }
    else
    {
        <section class="log-lab-overview">
            <div class="log-lab-filemark">LOG</div>
            <div class="log-lab-filename"><strong>@_document.FileName</strong><span>@_document.SourcePath</span></div>
            <div class="log-lab-stat"><small>FILE TYPE</small><strong title="Detected from the file extension and parsed content">@FormatLabel(_document)</strong></div>
            <div class="log-lab-stat"><small>ENTRIES</small><strong>@_document.Entries.Count.ToString("N0")</strong></div>
            <div class="log-lab-stat"><small>ENCODING</small><strong>@_document.DetectedEncoding</strong></div>
            <div class="log-lab-stat"><small>SIZE</small><strong>@FormatBytes(_document.ByteLength)</strong></div>
            <button class="log-lab-clear" title="Close imported log" @onclick="CloseDocument">×</button>
        </section>

        @if (_document.Warnings.Count > 0)
        {
            <section class="log-lab-warnings"><strong>Parser notes</strong><ul>@foreach (var warning in _document.Warnings.Take(8)) { <li>@warning</li> }</ul></section>
        }

        @if (_analysis is not null)
        {
            <section class="log-lab-analysis-overview">
                <div class="analysis-stat"><small>ANALYZED</small><strong>@_analysis.EntryCount.ToString("N0")</strong><span>entries</span></div>
                <div class="analysis-stat is-error"><small>ERROR SIGNALS</small><strong>@_analysis.ErrorCount.ToString("N0")</strong><span>by parsed severity</span></div>
                <div class="analysis-stat is-warning"><small>WARNINGS</small><strong>@_analysis.WarningCount.ToString("N0")</strong><span>by parsed severity</span></div>
                <div class="analysis-category-tray"><small>SCENARIO GROUPS · SELECT TO FILTER</small><div>
                    @foreach (var category in _analysis.CategoryCounts.Take(7))
                    {
                        <button class="analysis-category-chip @(_categoryFilter == category.Category.ToString() ? "active" : "")" @onclick="() => SetCategoryFilter(category.Category)">@category.Category <b>@category.Count</b></button>
                    }
                    @if (!string.IsNullOrEmpty(_categoryFilter)) { <button class="analysis-category-reset" @onclick="() => _categoryFilter = string.Empty">CLEAR FILTER</button> }
                </div></div>
            </section>
            <div class="log-lab-analysis-note">Rule match strength describes how many specific text signals matched. It is not confidence in a root cause; check each entry's evidence against the raw source.</div>
        }

        @if (_document is not null)
        {
            <section class="log-lab-sequences">
                <div class="sequence-heading"><div><span>SEQUENCE REVIEW</span><small>Timestamped entries use the selected window; entries without times use a 40-line adjacency fallback. Ordering does not prove causation.</small></div>
                    <div class="sequence-pivot-controls"><label>TIME WINDOW<select class="log-lab-select" @bind="_sequenceWindowMinutes" @bind:after="RefreshSequences"><option value="1">1 min</option><option value="5">5 min</option><option value="15">15 min</option><option value="30">30 min</option><option value="60">1 hour</option><option value="240">4 hours</option></select></label><label class="same-component-toggle"><input type="checkbox" @bind="_sameComponentOnly" @bind:after="RefreshSequences" /> SAME COMPONENT</label><b>@Math.Min(12, _sequenceFindings.Count) / @_sequenceFindings.Count</b></div>
                </div>
                @if (_sequenceFindings.Count == 0)
                {
                    <p class="sequence-empty">No sequence patterns matched these settings. Widen the window or turn off same-component matching to broaden the comparison.</p>
                }
                else
                {
                    <div class="sequence-list">
                        @foreach (var sequence in _sequenceFindings.Take(12))
                        {
                            <button class="sequence-item @(_selectedSequence == sequence ? "active" : "")" @onclick="() => FocusSequence(sequence)"><span class="sequence-kind">@sequence.Kind.ToString().Replace("RepeatedFailure", "REPEATED FAILURE").Replace("WarningEscalated", "WARNING → ERROR").Replace("ErrorFollowedByRecovery", "ERROR → SUCCESS")</span><strong>@sequence.Headline</strong><span>@sequence.Evidence</span><small>SOURCE LINES @string.Join(", ", sequence.SourceLines)</small></button>
                        }
                    </div>
                    @if (_selectedSequence is not null)
                    {
                        <div class="sequence-compare-title"><span>EVENT SEQUENCE SIDE-BY-SIDE</span><small>@_selectedSequence.Headline</small></div>
                        <div class="sequence-compare-grid">
                            @foreach (var sequenceEntry in SelectedSequenceEntries)
                            {
                                var comparison = AnalysisFor(sequenceEntry);
                                <article class="sequence-compare-card">
                                    <div class="sequence-compare-meta"><span>LINE @sequenceEntry.SourceLine · @sequenceEntry.Severity</span><b>@comparison.Category</b></div>
                                    <h3>@comparison.Headline</h3>
                                    <p>@sequenceEntry.Message</p>
                                    <div class="analysis-subhead">EVIDENCE</div>
                                    @foreach (var evidence in comparison.Evidence.Take(3)) { <div class="analysis-evidence"><small>@evidence.Field</small><span>@evidence.Value</span></div> }
                                    <button class="log-lab-text-btn" @onclick="() => FocusSequenceEntry(sequenceEntry.Index)">OPEN IN INSPECTOR</button>
                                </article>
                            }
                        </div>
                    }
                }
            </section>
        }

        @if (_timeline is not null)
        {
            <section class="log-lab-timeline">
                <div class="timeline-heading"><div><span>EVENT TIMELINE · UTC BUCKETS</span><small>@_timeline.EntriesWithTimestamps.ToString("N0") timestamped · @_timeline.EntriesWithoutTimestamps.ToString("N0") without timestamps · interval @_timeline.EffectiveIntervalMinutes min</small></div>
                    <select class="log-lab-select" @bind="_timelineIntervalMinutes" @bind:after="RefreshTimeline"><option value="1">1 min</option><option value="5">5 min</option><option value="15">15 min</option><option value="60">1 hour</option></select>
                </div>
                @if (_timeline.Buckets.Count == 0)
                {
                    <p class="timeline-empty">No entries have a recognized timestamp. Source-line ordering is still available in the entry list.</p>
                }
                else
                {
                    var maximum = Math.Max(1, _timeline.Buckets.Max(bucket => bucket.TotalCount));
                    <div class="timeline-chart" aria-label="Entry volume over time">
                        @foreach (var bucket in _timeline.Buckets)
                        {
                            var height = Math.Max(4, (int)Math.Round(bucket.TotalCount * 100d / maximum));
                            <button class="timeline-bucket @(_activeTimelineBucket == bucket.StartUtc ? "active" : "")" title="@TimelineTooltip(bucket)" @onclick="() => FilterTimelineBucket(bucket)">
                                <span class="timeline-volume" style="height:@height%"><i style="height:@TimelineErrorHeight(bucket)%"></i></span>
                                <small>@bucket.StartUtc.ToLocalTime().ToString("MM-dd HH:mm")</small>
                                <b>@bucket.TotalCount</b>
                            </button>
                        }
                    </div>
                    <div class="timeline-legend"><span><i class="timeline-total-key"></i>all entries</span><span><i class="timeline-error-key"></i>error entries</span><span>Click a bucket to filter the workspace by time.</span></div>
                }
            </section>
        }

        <div class="log-lab-toolbar">
            <label class="log-lab-search"><span>⌕</span><input @bind="_searchQuery" @bind:event="oninput" placeholder="Search entries, fields, error codes, messages…" /></label>
            <select class="log-lab-select" @bind="_severityFilter">
                <option value="">All severities</option>
                @foreach (var severity in Enum.GetValues<LogEntrySeverity>().Where(value => value != LogEntrySeverity.Unknown)) { <option value="@severity">@severity</option> }
            </select>
            <select class="log-lab-select" @bind="_categoryFilter">
                <option value="">All scenarios</option>
                @foreach (var category in Enum.GetValues<LogScenarioCategory>()) { <option value="@category">@category</option> }
            </select>
            <details class="log-filter-controls">
                <summary>ADVANCED FILTERS &amp; SAVED QUERIES</summary>
                <div class="log-filter-grid">
                    <label>COMPONENT / SOURCE<input @bind="_componentFilter" @bind:event="oninput" placeholder="service, logger, host..." /></label>
                    <label>FROM LOCAL TIME<input type="datetime-local" step="1" @bind="_fromLocal" /></label>
                    <label>TO LOCAL TIME<input type="datetime-local" step="1" @bind="_toLocal" /></label>
                    <div class="filter-preset-controls">
                        <select class="log-lab-select" @bind="_selectedPresetName"><option value="">Saved filter</option>@foreach (var preset in _searchPresets) { <option value="@preset.Name">@preset.Name</option> }</select>
                        <button class="log-lab-tool-btn" @onclick="ApplySearchPreset">LOAD FILTER</button>
                        <button class="log-lab-tool-btn" @onclick="SaveSearchPreset">SAVE CURRENT FILTER</button>
                        <button class="log-lab-tool-btn danger" @onclick="DeleteSearchPreset">DELETE FILTER</button>
                    </div>
                    <label>PRESET NAME<input @bind="_presetName" placeholder="e.g. failed auth on gateway" /></label>
                    <button class="log-lab-tool-btn" @onclick="ClearAllFilters">CLEAR ALL FILTERS</button>
                </div>
                <small>Conditions combine. Time values use your local timezone; the timeline and reports display UTC.</small>
            </details>
            <button class="log-lab-tool-btn" @onclick="FormatJson" title="Pretty-format the editor as JSON">FORMAT JSON</button>
            <button class="log-lab-tool-btn" @onclick="FormatXml" title="Pretty-format the editor as XML">FORMAT XML</button>
            <button class="log-lab-tool-btn" @onclick="ResetEditor">RESET EDITOR</button>
            <button class="log-lab-tool-btn" @onclick="ExportMarkdown">SAVE REPORT · MD</button>
            <button class="log-lab-tool-btn" @onclick="ExportJson">SAVE REPORT · JSON</button>
            <label class="log-wrap-toggle"><input type="checkbox" @bind="_wrapResults" /> WRAP RESULTS</label>
        </div>

        <details class="log-lab-profile-panel">
            <summary>USER PARSER PROFILES <span>REGEX RULES HAVE A 50 MS MATCH TIMEOUT · PROFILES STAY ON THIS WINDOWS ACCOUNT</span></summary>
            <div class="profile-controls">
                <select class="log-lab-select" @bind="_selectedProfileName"><option value="">Choose a profile</option><optgroup label="Built-in profiles">@foreach (var profile in _builtInProfiles) { <option value="builtin:@profile.Name">@profile.Name</option> }</optgroup><optgroup label="Saved profiles">@foreach (var profile in _savedProfiles) { <option value="saved:@profile.Name">@profile.Name</option> }</optgroup></select>
                <button class="log-lab-tool-btn" @onclick="LoadSelectedProfile">LOAD PROFILE JSON</button>
                <button class="log-lab-tool-btn" @onclick="SaveProfile">SAVE PROFILE</button>
                <button class="log-lab-tool-btn" @onclick="ApplyProfile">APPLY TO ORIGINAL SOURCE</button>
                <button class="log-lab-tool-btn danger" @onclick="DeleteProfile">DELETE SAVED PROFILE</button>
            </div>
            <textarea class="profile-json-editor" @bind="_profileJson" spellcheck="false" aria-label="Custom parser profile JSON"></textarea>
            <p>Profiles match one source line at a time. Define a <code>linePattern</code>, then field patterns with named capture groups (default group name: <code>value</code>). Applying a profile creates a derived view and keeps the original import available.</p>
        </details>
        <details class="log-lab-report-options">
            <summary>REPORT CONTENT OPTIONS</summary>
            <div>
                <label><input type="checkbox" @bind="_includeSummary" /> Overview counts</label>
                <label><input type="checkbox" @bind="_includeCategorySummary" /> Scenario breakdown</label>
                <label><input type="checkbox" @bind="_includeSequenceFindings" /> Sequence findings</label>
                <label><input type="checkbox" @bind="_includeNotableEntries" /> Notable entries</label>
                <label><input type="checkbox" @bind="_includeRecommendations" /> Suggested checks</label>
                <label><input type="checkbox" @bind="_includeParserNotes" /> Parser notes</label>
                <label><input type="checkbox" @bind="_includeTimeline" /> Timeline trend</label>
            </div>
        </details>
        <div class="report-privacy-note">Reports include log messages, extracted evidence, source line references, and analysis notes. Review the saved file before sharing it.</div>

        <div class="log-lab-workspace">
            <section class="log-lab-entry-panel">
                <div class="log-lab-panel-head"><div><span>PARSED ENTRIES</span><small>@FilteredEntries.Count.ToString("N0") shown of @((_document?.Entries.Count ?? 0).ToString("N0"))</small></div><span class="log-lab-count">@((_document?.Entries.Count ?? 0).ToString("N0"))</span></div>
                @if (FilteredEntries.Count == 0)
                {
                    <div class="log-lab-no-results">@(_document?.ContentKind == LogContentKind.BinaryLike ? "This file is mostly binary or encrypted. Structured entry parsing was skipped; use the decoded full-source preview." : "No entries match the current search.")</div>
                }
                else
                {
                    <div class="log-lab-entry-list @(_wrapResults ? "wrap-results" : "no-wrap-results")">
                        @foreach (var entry in FilteredEntries.Take(_entryLimit))
                        {
                            <button class="log-lab-entry @(_selectedEntry?.Index == entry.Index ? "selected" : "")" @onclick="() => SelectEntry(entry)">
                                <span class="log-lab-entry-top"><span class="severity-mark @SeverityClass(entry.Severity)"></span><strong>@(entry.Severity == LogEntrySeverity.Unknown ? "UNCLASSIFIED" : entry.Severity.ToString().ToUpperInvariant())</strong><span class="scenario-pill">@AnalysisFor(entry).Category</span><small>LINE @entry.SourceLine</small></span>
                                <span class="log-lab-entry-message">@((MarkupString)HighlightMatches(entry.Message))</span>
                                <span class="log-lab-entry-headline">@AnalysisFor(entry).Headline</span>
                                <span class="log-lab-entry-meta">@(entry.Timestamp?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff") ?? "No timestamp decoded")@(string.IsNullOrWhiteSpace(entry.Source) ? "" : $" · {entry.Source}")</span>
                            </button>
                        }
                    </div>
                    @if (FilteredEntries.Count > _entryLimit) { <button class="log-lab-more" @onclick="ShowMore">SHOW NEXT @Math.Min(500, FilteredEntries.Count - _entryLimit) ENTRIES</button> }
                }
            </section>

            <section class="log-lab-editor-panel">
                <div class="log-lab-panel-head"><div><span>RAW SOURCE EDITOR</span><small>@(_showWholeDocument ? "Full imported source · edits are local and do not alter the imported document" : _selectedEntry is null ? "Select an entry to inspect its source" : $"Entry {_selectedEntry.Index} · source line {_selectedEntry.SourceLine}")</small></div><button class="log-lab-text-btn" @onclick="ToggleWholeDocument">@(_showWholeDocument ? "SELECTED ENTRY" : "FULL SOURCE")</button></div>
                <div class="log-editor-tools"><input @bind="_editorFind" @bind:event="oninput" placeholder="Find in source" aria-label="Find in source" /><button class="log-lab-tool-btn" @onclick="() => FindInEditor(false)">FIND NEXT</button><button class="log-lab-tool-btn" @onclick="() => FindInEditor(true)">PREVIOUS</button><input @bind="_editorReplace" placeholder="Replace with" aria-label="Replacement text" /><button class="log-lab-tool-btn" @onclick="ReplaceCurrent">REPLACE</button><button class="log-lab-tool-btn" @onclick="ReplaceAll">REPLACE ALL</button><button class="log-lab-tool-btn" @onclick="CopyEditor">COPY</button><button class="log-lab-tool-btn" @onclick="SaveEditorCopy">SAVE COPY</button><label><input type="checkbox" @bind="_wrapEditor" /> WRAP</label><label><input type="checkbox" @bind="_syntaxHighlight" /> SYNTAX</label></div>
                @if (_syntaxHighlight) { <div class="log-editor-legend"><span class="log-token-timestamp">TIME</span><span class="log-token-severity">SEVERITY</span><span class="log-token-key">FIELD</span><span class="log-token-code">CODE</span><span class="log-token-string">STRING</span><span class="log-token-literal">TRUE / FALSE / NULL</span><span class="log-token-structure">STRUCTURE</span><small>BEST-EFFORT COLORING</small></div> }
                <div class="log-editor-codeview @(_syntaxOverlayEnabled ? "syntax-on" : "syntax-off")">
                    @if (_syntaxOverlayEnabled) { <pre class="log-editor-highlight @(_wrapEditor ? "wrap-text" : "no-wrap-text")" aria-hidden="true">@((MarkupString)HighlightedEditorHtml)</pre> }
                    <textarea @ref="_editorRef" class="log-lab-editor @(_wrapEditor ? "wrap-text" : "no-wrap-text") @(_syntaxOverlayEnabled ? "syntax-transparent" : "syntax-plain")" spellcheck="false" @bind="_editorText" @bind:after="MarkEditorDirty" placeholder="Select a parsed entry or open the full imported source…" aria-label="Log source editor"></textarea>
                </div>
                <div class="log-lab-editor-foot"><span>@(_editorDirty ? "Working copy has edits · imported source remains unchanged." : "Imported source remains unchanged. Formatting changes this working editor only.") @_editorStatus @(_syntaxHighlight && !_syntaxOverlayEnabled ? "Syntax colors pause above 300,000 characters to keep editing responsive." : "")</span><span>@_editorText.Length.ToString("N0") CHARS</span></div>
            </section>

            <section class="log-lab-detail-panel">
                <div class="log-lab-panel-head"><div><span>FIELD INSPECTOR</span><small>@(_selectedEntry is null ? "No entry selected" : $"Parser basis · line {_selectedEntry.SourceLine}")</small></div><span class="log-lab-orbit">✦</span></div>
                <!-- Shared guarded AI review: always visible, enabled once an entry is selected -->
                <AiReviewPanel Title="AI SECOND OPINION"
                               BusyLabel="ANALYZING SELECTED ENTRY..."
                               ResultFooter="AI RESPONSE · MARKDOWN · VERIFY AGAINST ORIGINAL LOG"
                               ScopeNote="Only this selected entry and its parsed fields are submitted. The local rule-based findings remain available without an API key."
                               EmptyHint="Select a parsed entry to enable AI review of that one line."
                               SelectionKey="@(_selectedEntry?.Index.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                               RequestFactory="BuildAiLogEntryRequest"
                               CssClass="log-lab-ai-review" />

                @if (_selectedEntry is { } selected)
                {
                    <div class="log-lab-detail-scroll">
                        <div class="log-lab-headline"><span class="severity-chip @SeverityClass(selected.Severity)">@selected.Severity.ToString().ToUpperInvariant()</span><h2>@selected.Message</h2></div>
                        @if (_analysis?.Entries.TryGetValue(selected.Index, out var finding) == true)
                        {
                            <div class="scenario-analysis-card">
                                <div class="scenario-analysis-title"><span>@finding.Category.ToString().ToUpperInvariant()</span><b class="match-strength @finding.MatchStrength.ToString().ToLowerInvariant()">@(finding.MatchStrength switch { RuleMatchStrength.NoRuleMatched => "NO RULE MATCHED", _ => $"{finding.MatchStrength.ToString().ToUpperInvariant()} SIGNAL MATCH" })</b></div>
                                <h3>@finding.Headline</h3>
                                <p>@finding.Explanation</p>
                                @if (!string.IsNullOrWhiteSpace(finding.KnowledgeSource)) { <a class="knowledge-source-link" href="@finding.KnowledgeSource" target="_blank" rel="noopener noreferrer">SOURCE REFERENCE · @finding.KnowledgeId ↗</a> }
                                <div class="analysis-tags">@foreach (var tag in finding.Tags) { <span>@tag</span> }</div>
                                @if (finding.Evidence.Count > 0)
                                {
                                    <div class="analysis-subhead">MATCHED EVIDENCE</div>
                                    @foreach (var evidence in finding.Evidence) { <div class="analysis-evidence"><small>@evidence.Field</small><span>@evidence.Value</span></div> }
                                }
                                <div class="analysis-subhead">SUGGESTED CHECKS</div>
                                <ul class="analysis-recommendations">@foreach (var recommendation in finding.Recommendations) { <li>@recommendation</li> }</ul>
                                @if (IsCrashSpecific(selected, finding))
                                {
                                    <button class="cf-log-handoff-button" @onclick="() => OpenCrashForensics(selected, finding)"><span>𓃣</span> OPEN THIS FINDING IN CRASH FORENSICS <b>↗</b></button>
                                }
                            </div>
                        }
                        <div class="log-lab-evidence-callout"><strong>HOW THIS WAS READ</strong><p>@selected.InterpretationBasis</p></div>
                        <div class="log-lab-field-grid">
                            @if (selected.Timestamp is { } timestamp) { <div class="log-lab-field"><small>DECODED TIME (UTC)</small><strong>@timestamp.ToUniversalTime().ToString("O")</strong></div> }
                            @if (!string.IsNullOrWhiteSpace(selected.Source)) { <div class="log-lab-field"><small>RECORDED SOURCE</small><strong>@selected.Source</strong></div> }
                            <div class="log-lab-field"><small>SOURCE RANGE</small><strong>Line @selected.SourceLine@(selected.SourceLineEnd > selected.SourceLine ? $"–{selected.SourceLineEnd}" : "")</strong></div>
                        </div>
                        @if (selected.Fields.Count > 0)
                        {
                            <div class="log-lab-fields-title">EXTRACTED FIELDS <span>@selected.Fields.Count</span></div>
                            <dl class="log-lab-fields">@foreach (var (key, value) in selected.Fields) { <dt>@key</dt><dd>@value</dd> }</dl>
                        }
                    </div>
                }
                else
                {
                    <div class="log-lab-no-selection"><span>⌖</span><strong>@(_document?.ContentKind == LogContentKind.BinaryLike ? "Raw preview only" : "Select an entry")</strong><p>@(_document?.ContentKind == LogContentKind.BinaryLike ? "No findings are inferred from binary-like bytes. Review the decoded source manually." : "Parsed fields, source location, and the parser's reasoning will appear here.")</p></div>
                }
            </section>
        </div>
    }
</div>

@code {
    private LogDocument? _document;
    private LogDocument? _sourceDocument;
    private ParsedLogEntry? _selectedEntry;
    private string _searchQuery = string.Empty;
    private string _severityFilter = string.Empty;
    private string _editorText = string.Empty;
    private string _editorFind = string.Empty;
    private string _editorReplace = string.Empty;
    private string _editorStatus = string.Empty;
    private bool _editorDirty;
    private bool _wrapEditor = true;
    private bool _wrapResults = true;
    private int _editorFindPosition;
    private ElementReference _editorRef;
    private bool _editorScrollSyncAttached;
    private bool _resetEditorScrollAfterRender;
    private bool? _lastRenderedSyntaxOverlay;
    private bool? _lastRenderedEditorWrap;
    private readonly LogSyntaxHighlighter _syntaxHighlighter = new();
    private string _highlightCacheSource = string.Empty;
    private string _highlightCacheHtml = string.Empty;
    private bool _syntaxHighlight = true;
    private bool _syntaxOverlayEnabled => _syntaxHighlight && _editorText.Length <= LogSyntaxHighlighter.MaximumHighlightCharacters;
    private string HighlightedEditorHtml
    {
        get
        {
            if (_highlightCacheSource == _editorText) return _highlightCacheHtml;
            var builder = new System.Text.StringBuilder(_editorText.Length + 256);
            var cursor = 0;
            foreach (var token in _syntaxHighlighter.Tokenize(_editorText))
            {
                if (token.Start < cursor) continue;
                builder.Append(System.Net.WebUtility.HtmlEncode(_editorText[cursor..token.Start]));
                builder.Append("<span class=\"log-token-").Append(token.Kind.ToString().ToLowerInvariant()).Append("\">")
                    .Append(System.Net.WebUtility.HtmlEncode(_editorText.Substring(token.Start, token.Length))).Append("</span>");
                cursor = token.Start + token.Length;
            }
            builder.Append(System.Net.WebUtility.HtmlEncode(_editorText[cursor..]));
            _highlightCacheSource = _editorText;
            _highlightCacheHtml = builder.ToString();
            return _highlightCacheHtml;
        }
    }
    private string _statusMessage = string.Empty;
    private bool _isError;
    private bool _showWholeDocument;
    private int _entryLimit = 500;
    private string _categoryFilter = string.Empty;
    private LogAnalysisReport? _analysis;
    private IReadOnlyList<LogSequenceFinding> _sequenceFindings = [];
    private LogTimelineReport? _timeline;
    private int _timelineIntervalMinutes = 5;
    private DateTimeOffset? _activeTimelineBucket;
    private int _sequenceWindowMinutes = 15;
    private bool _sameComponentOnly;
