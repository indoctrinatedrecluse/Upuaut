    private static bool IsCrashSpecific(ParsedLogEntry entry, LogEntryAnalysis finding)
    {
        if (finding.Category == LogScenarioCategory.Crash) return true;
        var text = $"{entry.Message}\n{entry.RawText}";
        return new[] { "unhandled exception", "application error", "application crash", "faulting application", "faulting module", "bugcheck", "bug check", "bsod", "minidump", "memory.dmp", ".wer", "exception code", "exception 0x" }
            .Any(signal => text.Contains(signal, StringComparison.OrdinalIgnoreCase));
    }

