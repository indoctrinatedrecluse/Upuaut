    private List<ParsedLogEntry> FilteredEntries
    {
        get
        {
            if (_document is null) return new();
            if (!ReferenceEquals(_filteredDocument, _document) || _filteredQuery != _searchQuery || _filteredSeverity != _severityFilter || _filteredCategory != _categoryFilter || _filteredComponent != _componentFilter || _filteredFrom != _fromLocal || _filteredTo != _toLocal)
            {
                _filteredDocument = _document;
                _filteredQuery = _searchQuery;
                _filteredSeverity = _severityFilter;
                _filteredCategory = _categoryFilter;
                _filteredComponent = _componentFilter;
                _filteredFrom = _fromLocal;
                _filteredTo = _toLocal;
                var severity = Enum.TryParse<LogEntrySeverity>(_severityFilter, out var level) ? level : (LogEntrySeverity?)null;
                var query = _searchQuery.Trim();
                _filteredEntries = ParsingEngine.Search(_document, new LogSearchOptions(string.Empty, severity, _componentFilter, ParseLocalTime(_fromLocal), ParseLocalTime(_toLocal)))
                    .Where(entry => (_categoryFilter.Length == 0 || AnalysisFor(entry).Category.ToString() == _categoryFilter) &&
                        (query.Length == 0 || MatchesAnalysis(entry, query)))
                    .ToList();
            }
            return _filteredEntries;
        }
    }

    private async Task ImportFile()
    {
        var dialog = new OpenFileDialog
        {
            Title = "Import a log for analysis",
            Filter = "Log, text, and data files (*.log;*.txt;*.out;*.err;*.json;*.jsonl;*.ndjson;*.xml;*.csv;*.ini;*.conf;*.logfmt;*.syslog;*.hex;*.sav;*.sln;*.dat;*.bin)|*.log;*.txt;*.out;*.err;*.json;*.jsonl;*.ndjson;*.xml;*.csv;*.ini;*.conf;*.logfmt;*.syslog;*.hex;*.sav;*.sln;*.dat;*.bin|All files (*.*)|*.*",
            CheckFileExists = true,
            Multiselect = false
        };
        if (dialog.ShowDialog() != true) return;
        try
        {
            _statusMessage = "Reading source and extracting entry fields…"; _isError = false;
            _document = await ParsingEngine.ImportFileAsync(dialog.FileName);
            _editorScrollSyncAttached = false;
            _sourceDocument = _document;
            if (_document.Warnings.Count > 0)
            {
                foreach (var warning in _document.Warnings.Take(3))
                    Logger.LogWarning("Log Lab import note for {FileName}: {Warning}", _document.FileName, warning);
                if (_document.Warnings.Count > 3)
                    Logger.LogWarning("Log Lab import generated {AdditionalWarningCount} additional parser notes; details remain available in the Log Lab warning panel.", _document.Warnings.Count - 3);
            }
            _analysis = null; _sequenceFindings = []; _timeline = null; _selectedSequence = null; _selectedEntry = null; _filteredDocument = null; _activeTimelineBucket = null;
            _statusMessage = "Grouping scenario signals and preparing evidence...";
            await InvokeAsync(StateHasChanged);
            await AnalyzeCurrentDocumentAsync();
            _selectedEntry = _analysis is null ? null : _document.Entries.FirstOrDefault(); _searchQuery = string.Empty; _severityFilter = string.Empty; _entryLimit = 500;
            _categoryFilter = string.Empty;
            _showWholeDocument = _analysis is null || _document.ContentKind == LogContentKind.BinaryLike || _document.Warnings.Any(warning => warning.Contains("raw-text mode", StringComparison.OrdinalIgnoreCase) || warning.Contains("decoded raw text", StringComparison.OrdinalIgnoreCase));
            if (_showWholeDocument) _editorText = _document.OriginalText; else ResetEditor();
            _resetEditorScrollAfterRender = true;
            if (_analysis is null)
            {
                _statusMessage = $"Imported {_document.FileName}; structured analysis failed, so the complete source is open in raw editor mode.";
                _isError = true;
            }
            else _statusMessage = $"Imported {_document.Entries.Count:N0} entries from {_document.FileName}. Original source is preserved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Log Lab could not import {FilePath}", dialog.FileName);
            _statusMessage = $"Could not import this log: {ex.Message}"; _isError = true;
        }
    }

