    private static DateTimeOffset? ParseLocalTime(DateTime? value)
    {
        if (value is null) return null;
        var local = DateTime.SpecifyKind(value.Value, DateTimeKind.Unspecified);
        return new DateTimeOffset(local, TimeZoneInfo.Local.GetUtcOffset(local)).ToUniversalTime();
    }

    private static DateTime? ParsePresetDate(string value) => DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var date) ? DateTime.SpecifyKind(date, DateTimeKind.Unspecified) : null;

    private void FocusSequence(LogSequenceFinding finding)
    {
        if (_document is null || finding.EntryIndices.Count == 0) return;
        _selectedSequence = finding;
        FocusSequenceEntry(finding.EntryIndices[0]);
    }

    private void FocusSequenceEntry(int entryIndex)
    {
        if (_document is null) return;
        _searchQuery = string.Empty; _severityFilter = string.Empty; _categoryFilter = string.Empty;
        _selectedEntry = _document.Entries.FirstOrDefault(entry => entry.Index == entryIndex);
        _showWholeDocument = false;
        _editorText = _selectedEntry?.RawText ?? string.Empty; _editorDirty = false; _resetEditorScrollAfterRender = true;
        _filteredDocument = null;
        var position = FilteredEntries.FindIndex(entry => entry.Index == _selectedEntry?.Index);
        if (position >= 0) _entryLimit = Math.Max(_entryLimit, position + 1);
    }

    private void LoadSelectedProfile()
    {
        var isBuiltIn = _selectedProfileName.StartsWith("builtin:", StringComparison.Ordinal);
        var prefix = isBuiltIn ? "builtin:" : "saved:";
        if (!isBuiltIn && !_selectedProfileName.StartsWith(prefix, StringComparison.Ordinal)) { _statusMessage = "Choose a built-in or saved profile first."; _isError = true; return; }
        var name = _selectedProfileName[prefix.Length..];
        var profile = isBuiltIn ? _builtInProfiles.FirstOrDefault(item => item.Name == name) : _savedProfiles.FirstOrDefault(item => item.Name == name);
        if (profile is null) { _statusMessage = "The selected profile is no longer available."; _isError = true; return; }
        _profileJson = ProfileService.Serialize(profile); _statusMessage = $"Loaded profile '{profile.Name}' into the editor."; _isError = false;
    }

    private void SaveProfile()
    {
        try
        {
            var profile = ProfileService.ParseAndValidate(_profileJson);
            ProfileService.SaveProfile(profile);
            _savedProfiles = ProfileService.LoadProfiles(); _selectedProfileName = $"saved:{profile.Name}";
            _profileJson = ProfileService.Serialize(profile); _statusMessage = $"Saved parser profile '{profile.Name}' to this Windows account."; _isError = false;
        }
        catch (Exception ex) { _statusMessage = $"Could not save parser profile: {ex.Message}"; _isError = true; }
    }

    private async Task ApplyProfile()
    {
        if (_sourceDocument is null) { _statusMessage = "Import a source log before applying a profile."; _isError = true; return; }
        try
        {
            var profile = ProfileService.ParseAndValidate(_profileJson);
            _analysis = null; _sequenceFindings = []; _timeline = null; _activeTimelineBucket = null;
            _selectedSequence = null; _selectedEntry = null; _filteredDocument = null;
            _statusMessage = $"Applying '{profile.Name}' to the original source..."; _isError = false;
            await InvokeAsync(StateHasChanged);
            var result = await Task.Run(() => ProfileService.Apply(_sourceDocument, profile));
            _document = result.Document;
            await AnalyzeCurrentDocumentAsync();
            _selectedEntry = _document.Entries.FirstOrDefault(); _entryLimit = 500; _categoryFilter = string.Empty; _searchQuery = string.Empty; _severityFilter = string.Empty;
            _showWholeDocument = false; ResetEditor();
            _statusMessage = $"Profile '{profile.Name}' matched {result.MatchedLines:N0} source lines. The original source remains available.";
        }
        catch (Exception ex) { _statusMessage = $"Could not apply parser profile: {ex.Message}"; _isError = true; }
    }

    private void DeleteProfile()
    {
        if (!_selectedProfileName.StartsWith("saved:", StringComparison.Ordinal)) { _statusMessage = "Choose a saved profile to delete."; _isError = true; return; }
        try
        {
            var name = _selectedProfileName["saved:".Length..];
            ProfileService.DeleteProfile(name); _statusMessage = $"Deleted profile '{name}'.";
            _savedProfiles = ProfileService.LoadProfiles(); _selectedProfileName = string.Empty; _isError = false;
        }
        catch (Exception ex) { _statusMessage = $"Could not delete profile: {ex.Message}"; _isError = true; }
    }

