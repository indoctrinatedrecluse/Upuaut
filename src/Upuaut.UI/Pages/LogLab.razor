    private AiInvestigationRequest? BuildAiLogEntryRequest()
    {
        if (_selectedEntry is not { } selected) return null;

        return AiPromptEngine.BuildLogEntryRequest(
            selected.RawText,
            _document?.FileTypeLabel,
            _document?.Format.ToString(),
            selected.Source,
            selected.SourceLine,
            selected.Severity.ToString(),
