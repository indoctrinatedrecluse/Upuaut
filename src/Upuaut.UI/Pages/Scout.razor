@page "/scout"
@namespace Upuaut.UI.Pages
@using System.Text
@using Upuaut.Core.Interfaces
@using Upuaut.Core.Models
@using Upuaut.Scout.Services
@using Microsoft.Win32
@inject ICaptureEngine CaptureEngine
@inject ScoutManager ScoutService
@inject IJSRuntime JSRuntime
@inject Upuaut.UI.Shared.InvestigationContext Investigation
@implements IDisposable

<PageTitle>Upuaut — The Scout (Packet Sniffer)</PageTitle>

<div class="scout-container">
    <!-- Top Scout Control & Adapter Header -->
    <div class="scout-header">
        <div class="scout-title-block">
            <div class="scout-eyebrow"><span class="scout-eyebrow-rule"></span> UPUAUT // VANGUARD NETWORK SURVEILLANCE</div>
            <h1 class="header-main-title">
                <span class="gold-accent">🐺</span> The Scout
            </h1>
            <span class="header-sub-title">
                Open the way through the wire. Observe traffic, decode its path, identify its bearer.
            </span>
        </div>

        <div class="scout-actions-bar">
            <div class="filter-group">
                <span class="filter-label">Capture:</span>
                <select class="upuaut-select" @bind="_captureMode" @bind:after="OnCaptureModeChanged" disabled="@_isCapturing">
                    <option value="RawIpv4">Native IPv4 (no driver)</option>
                    <option value="Ethernet">Ethernet frames (Npcap)</option>
                </select>
            </div>
            <!-- Adapter Selector -->
            <div class="filter-group">
                <span class="filter-label">Adapter:</span>
                <select class="upuaut-select" @bind="_selectedDeviceId" disabled="@_isCapturing">
                    @if (_devices.Count == 0)
                    {
                        <option value="">No compatible adapters detected</option>
                    }
                    @foreach (var dev in _devices)
                    {
                        <option value="@dev.Id" title="@dev.Description">@AdapterLabel(dev)</option>
                    }
                </select>
            </div>
            <button class="pill-btn" @onclick="RefreshDevices" disabled="@_isCapturing">Refresh adapters</button>
            <span class="scout-adapter-hint">@AdapterHint</span>
            @if (_devices.Count == 0) { <span class="scout-adapter-warning">@_filterError</span> }

            <!-- Start / Stop Button -->
            @if (!_isCapturing)
            {
                <FluentButton Appearance="ButtonAppearance.Primary"
                              IconStart="@(new Icons.Regular.Size16.Play())"
                              OnClick="StartCaptureAsync"
                              Disabled="@string.IsNullOrWhiteSpace(_selectedDeviceId)">
                    Start Capture
                </FluentButton>
            }
            else
            {
                <FluentButton Appearance="ButtonAppearance.Primary"
                              IconStart="@(new Icons.Regular.Size16.Stop())"
                              OnClick="StopCaptureAsync">
                    <span class="pulse-dot"></span> Stop Capture
                </FluentButton>
            }

            <!-- Clear Button -->
            <FluentButton Appearance="ButtonAppearance.Outline"
                          IconStart="@(new Icons.Regular.Size16.Delete())"
                          OnClick="ClearBuffer">
                Clear
            </FluentButton>

            <!-- Mode Badge -->
            <div class="badge-chip gold-chip" title="IPv4 raw sockets need elevation; Ethernet capture needs Npcap">
                <span>@(_captureMode == PacketCaptureMode.RawIpv4 ? "IPv4 · Elevated" : "Ethernet · Npcap")</span>
            </div>
        </div>
    </div>

    <!-- Live KPI Summary Cards -->
    <div class="kpi-row">
        <div class="kpi-card">
            <span class="kpi-title">TOTAL PACKETS</span>
            <span class="kpi-value gold-accent">@_stats.TotalPackets.ToString("N0")</span>
            <span class="kpi-sub">Buffer @ScoutService.BufferCount / @ScoutService.BufferCapacity · engine @_stats.ReceivedByEngine · malformed @_stats.MalformedPackets · socket errors @_stats.CaptureReceiveErrors</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-title" style="color: #60A5FA;">DATA VOLUME</span>
            <span class="kpi-value" style="color: #60A5FA;">@FormatBytes(_stats.TotalBytes)</span>
            <span class="kpi-sub">Real-time wire throughput</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-title" style="color: #34D399;">PACKET RATE</span>
            <span class="kpi-value" style="color: #34D399;">@(_stats.PacketsPerSecond.ToString("F1")) pps</span>
            <span class="kpi-sub">@(_isCapturing ? "Capturing active" : "Standby")</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-title" style="color: #F59E0B;">ACTIVE PROCESSES</span>
            <span class="kpi-value" style="color: #F59E0B;">@_stats.TopProcesses.Count</span>
            <span class="kpi-sub">Attributed via IP Helper</span>
        </div>
    </div>

    <!-- Filter & Search Ribbon -->
    <div class="filter-ribbon">
        <!-- Protocol Pills -->
        <div class="level-pills">
            <span class="filter-label">Protocol:</span>
            <button class="pill-btn @(_selectedProtocol == null ? "pill-info-active" : "")"
                    @onclick="@(() => SetProtocol(null))">
                All
            </button>
            <button class="pill-btn @(_selectedProtocol == NetworkProtocol.TCP ? "pill-info-active" : "")"
                    @onclick="@(() => SetProtocol(NetworkProtocol.TCP))">
                TCP
            </button>
            <button class="pill-btn @(_selectedProtocol == NetworkProtocol.TLS ? "pill-info-active" : "")"
                    @onclick="@(() => SetProtocol(NetworkProtocol.TLS))">
                TLS / HTTPS
            </button>
            <button class="pill-btn @(_selectedProtocol == NetworkProtocol.DNS ? "pill-info-active" : "")"
                    @onclick="@(() => SetProtocol(NetworkProtocol.DNS))">
                DNS
            </button>
            <button class="pill-btn @(_selectedProtocol == NetworkProtocol.UDP ? "pill-info-active" : "")"
                    @onclick="@(() => SetProtocol(NetworkProtocol.UDP))">
                UDP
            </button>
            <button class="pill-btn @(_selectedProtocol == NetworkProtocol.ICMP ? "pill-info-active" : "")"
                    @onclick="@(() => SetProtocol(NetworkProtocol.ICMP))">
                ICMP
            </button>
            <button class="pill-btn @(_selectedProtocol == NetworkProtocol.IPv6 ? "pill-info-active" : "")" @onclick="@(() => SetProtocol(NetworkProtocol.IPv6))">IPv6</button>
            <button class="pill-btn @(_selectedProtocol == NetworkProtocol.ICMPv6 ? "pill-info-active" : "")" @onclick="@(() => SetProtocol(NetworkProtocol.ICMPv6))">ICMPv6</button>
        </div>

        <!-- Process Filter Dropdown -->
        @if (_stats.TopProcesses.Count > 0)
        {
            <div class="filter-group">
                <span class="filter-label">Process:</span>
                <select class="upuaut-select" @bind="_selectedProcess" @bind:after="ApplyFilters">
                    <option value="">All Processes</option>
                    @foreach (var (procName, count) in _stats.TopProcesses)
                    {
                        <option value="@procName">@procName (@count)</option>
                    }
                </select>
            </div>
        }

        <!-- Search Input -->
        <div class="search-box-container" style="flex: 1;">
            <span class="search-icon">🔍</span>
            <input type="text"
                   class="upuaut-search-input"
                   placeholder="Filter by IP, port, host domain, or payload..."
                   value="@_searchFilter"
                   @oninput="OnSearchChanged" />
        </div>

        <!-- Auto-scroll checkbox -->
        <label class="switch-container" style="margin-left: 0.5rem;">
            <input type="checkbox" @bind="_autoScroll" />
            <span class="switch-label">Auto-scroll</span>
        </label>
    </div>

    <div class="scout-filter-lab">
        <label><span>CAPTURE FILTER <small>(user-space filter before buffering)</small></span><input class="upuaut-search-input" @bind="_captureFilter" disabled="@_isCapturing" placeholder="tcp.port == 443" /></label>
        <label><span>DISPLAY FILTER <small>(common Wireshark-style fields; combine with &&)</small></span><input class="upuaut-search-input" @bind="_displayFilter" @bind:event="oninput" @bind:after="ApplyFilters" placeholder="ip.src == 10.0.0.1 && tcp.port == 443" /></label>
        <select class="upuaut-select" value="" @onchange="OnSavedFilterSelected"><option value="">Saved filters…</option>@foreach (var saved in _savedFilters) { <option value="@saved">@saved</option> }</select>
        <label class="switch-container"><input type="checkbox" @bind="_useSharedTimeWindow" @bind:after="ApplyFilters" /><span class="switch-label">Shared time window</span></label>
        <button class="pill-btn" @onclick="SaveFilterAsync">Save filter</button><button class="pill-btn" @onclick="OpenCapture">Open PCAPNG</button><button class="pill-btn" @onclick="SaveCapture">Save PCAPNG</button>
        @if (_offlineFrames is not null) { <button class="pill-btn" @onclick="CloseOfflineCapture">Return to live buffer</button> }
        <span class="scout-buffer-note">@_stats.CaptureFiltered filtered · @_stats.BufferEvictions overwritten by FIFO · buffer @_stats.BufferCapacity.ToString("N0") · @_stats.CaptureDuration elapsed</span>
        @if (!string.IsNullOrEmpty(_filterError)) { <span class="scout-filter-error">@_filterError</span> }
    </div>
    <div class="scout-view-tabs"><button class="pill-btn @(_activeView == "packets" ? "pill-info-active" : "")" @onclick='() => _activeView = "packets"'>Packets</button><button class="pill-btn @(_activeView == "conversations" ? "pill-info-active" : "")" @onclick='() => _activeView = "conversations"'>Conversations &amp; endpoints</button></div>
    @if (_activeView == "conversations")
    {
        <div class="scout-conversation-list"><table class="upuaut-table"><thead><tr><th>Protocol</th><th>Endpoint A</th><th>Endpoint B</th><th>Frames</th><th>Bytes</th><th>Last seen</th><th></th></tr></thead><tbody>
        @foreach (var c in _conversations) { <tr @onclick="() => SelectConversation(c)"><td>@c.Protocol</td><td>@c.EndpointA</td><td>@c.EndpointB</td><td>@c.PacketCount</td><td>@FormatBytes(c.Bytes)</td><td>@c.LastSeen.ToLocalTime().ToString("HH:mm:ss.fff")</td><td>@if (c.Protocol == NetworkProtocol.TCP) { <button class="pill-btn" @onclick="() => FollowStream(c)" @onclick:stopPropagation="true">Follow</button> }</td></tr> }
        </tbody></table></div>
    }
    else
    {
    <!-- Main Workspace: Split Frame List & Packet Inspector -->
    <div class="scout-workspace">
        <!-- Left: Live Frame Stream -->
        <div class="packet-list-pane">
            <div class="scout-pane-heading">
                <div><span class="scout-pane-glyph">𓆣</span><div><strong>WIRE TAPE</strong><small>LIVE FRAME STREAM · MOST RECENT FIRST</small></div></div>
                <span class="scout-stream-state @(_isCapturing ? "is-live" : "")"><i></i>@(_offlineFrames is not null ? "OFFLINE PCAPNG" : _isCapturing ? "SCOUTING" : "ON WATCH")</span>
            </div>
            <div class="table-container">
                <table class="upuaut-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th style="width: 100px;">Time</th>
                            <th style="width: 140px;">Process</th>
                            <th style="width: 170px;">Source</th>
                            <th style="width: 170px;">Destination</th>
                            <th style="width: 80px;">Proto</th>
                            <th style="width: 70px;">Len</th>
                            <th>Summary / Flags</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_filteredFrames.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="empty-state">
                                    <div class="empty-state-content">
                                        <div class="scout-radar" aria-hidden="true"><span></span><b>𓃢</b></div>
                                        <strong>@(_isCapturing ? "Listening at the threshold" : "The path is quiet")</strong>
                                        <span>@(_isCapturing ? "Waiting for matching packets on wire..." : "Capture in standby. Click 'Start Capture' above to sniff live packets.")</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var frame in _filteredFrames)
                            {
                                <tr class="table-row @(_selectedFrame?.FrameNumber == frame.FrameNumber ? "row-selected" : "") @(frame.HasErrorOrRetransmit ? "row-error" : "")"
                                    @onclick="@(() => SelectFrame(frame))">
                                    <td class="mono-text">@frame.FrameNumber</td>
                                    <td class="mono-text">@frame.Timestamp.ToString("HH:mm:ss.fff")</td>
                                    <td class="proc-cell" title="@(frame.ProcessName ?? "System") (PID: @frame.ProcessId)">
                                        @if (!string.IsNullOrEmpty(frame.ProcessName))
                                        {
                                            <span class="proc-badge">@frame.ProcessName</span>
                                        }
                                        else
                                        {
                                            <span class="proc-unknown">—</span>
                                        }
                                    </td>
                                    <td class="mono-text">@frame.SourceIp@FormatPort(frame.SourcePort)</td>
                                    <td class="mono-text">@frame.DestinationIp@FormatPort(frame.DestinationPort)</td>
                                    <td>
                                        <span class="proto-badge @GetProtocolBadgeClass(frame.Protocol)">
                                            @frame.Protocol
                                        </span>
                                    </td>
                                    <td class="mono-text">@frame.TotalLength</td>
                                    <td class="summary-cell" title="@frame.Summary">
                                        @if (frame.HasErrorOrRetransmit)
                                        {
                                            <span class="warn-pill">RESET</span>
                                        }
                                        @frame.Summary
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right: Packet Details & Hex Viewer -->
        <div class="packet-inspector-pane">
            <div class="scout-pane-heading inspector-pane-heading">
                <div><span class="scout-pane-glyph">𓂀</span><div><strong>SEER’S LENS</strong><small>FRAME INSPECTION &amp; ATTRIBUTION</small></div></div>
                <span class="scout-inspector-seal">𓋹</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(_followStreamText))
            {
                <section class="section-block tcp-follow-stream"><div class="scout-pane-heading"><strong>TCP FOLLOW STREAM</strong><button class="pill-btn" @onclick="() => _followStreamText = null">Close</button></div><p class="scout-buffer-note">Sequence-ordered payload from frames in the current filtered buffer. Missing sequence ranges are marked; encrypted TLS bytes remain opaque.</p><pre class="hex-dump-box">@_followStreamText</pre></section>
            }
            @if (_selectedFrame != null)
            {
                <div class="inspector-card">
                    <div class="inspector-header">
                        <div class="ins-title-row">
                            <span class="proto-badge @GetProtocolBadgeClass(_selectedFrame.Protocol)">
                                @_selectedFrame.Protocol Frame #@_selectedFrame.FrameNumber
                            </span>
                            <span class="mono-text" style="font-size: 0.8rem; color: var(--upuaut-text-muted);">
                                @_selectedFrame.TotalLength bytes
                            </span>
                        </div>
                        <h3 class="ins-summary">@_selectedFrame.Summary</h3>
                    </div>

                    @if (_selectedFrame.Interpretation is { } reading)
                    {
                        <section class="section-block" style="border: 1px solid var(--upuaut-gold); border-radius: 10px; padding: 1rem; margin: 1rem;">
                            <div class="tech-key">@reading.Category · RULE MATCH @reading.RuleMatchStrength%</div>
                            <h3>@reading.Headline</h3>
                            <p>@reading.Summary</p>
                            <small style="color: var(--upuaut-text-muted);">@reading.MatchBasis</small>
                            <div style="display:flex; flex-wrap:wrap; gap:.4rem; margin:.6rem 0;">@foreach (var tag in reading.Tags) { <span class="proto-badge">@tag</span> }</div>
                            @if (reading.Evidence.Count > 0) { <details><summary>Evidence</summary><ul>@foreach (var item in reading.Evidence) { <li><strong>@item.Label:</strong> @item.Value — @item.Interpretation</li> }</ul></details> }
                            @if (reading.Recommendations.Count > 0) { <h4>Suggested checks</h4><ul>@foreach (var item in reading.Recommendations) { <li>@item</li> }</ul> }
                        </section>
                    }

                    <div class="inspector-body">
                        <!-- Process Attribution Card -->
                        <div class="section-block">
                            <h4 class="section-title" style="color: var(--upuaut-gold);">
                                <span>🎯 Process Attribution (IP Helper)</span>
                            </h4>
                            <div class="tech-grid">
                                <div class="tech-item">
                                    <span class="tech-key">PROCESS NAME</span>
                                    <span class="tech-val gold-accent" style="font-weight: 700;">
                                        @(_selectedFrame.ProcessName ?? "Unattributed / Kernel")
                                    </span>
                                </div>
                                <div class="tech-item">
                                    <span class="tech-key">PROCESS ID</span>
                                    <span class="tech-val mono-text">
                                        @(_selectedFrame.ProcessId?.ToString() ?? "N/A")
                                    </span>
                                </div>
                                <div class="tech-item">
                                    <span class="tech-key">INTERFACE</span>
                                    <span class="tech-val">@(_selectedFrame.InterfaceName ?? "Default")</span>
                                </div>
                                <div class="tech-item">
                                    <span class="tech-key">CAPTURE LAYER</span>
                                    <span class="tech-val">@_selectedFrame.CaptureLayer</span>
                                </div>
                                <div class="tech-item">
                                    <span class="tech-key">TIMESTAMP</span>
                                    <span class="tech-val mono-text">@_selectedFrame.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Network 4-Tuple -->
                        <div class="section-block">
                            <h4 class="section-title">Network Socket Coordinates</h4>
                            @if (_selectedFrame.SourceMac is not null || _selectedFrame.DestinationMac is not null)
                            {
                                <div class="mono-text" style="margin-bottom: 0.75rem;">@_selectedFrame.SourceMac &rarr; @_selectedFrame.DestinationMac · EtherType 0x@_selectedFrame.EtherType?.ToString("X4")</div>
                            }
                            <div class="socket-grid">
                                <div class="socket-box">
                                    <span class="tech-key">SOURCE</span>
                                    <span class="socket-ip">@_selectedFrame.SourceIp</span>
                                    <span class="socket-port">Port @(_selectedFrame.SourcePort?.ToString() ?? "—")</span>
                                </div>
                                <div class="socket-arrow">&rarr;</div>
                                <div class="socket-box">
                                    <span class="tech-key">DESTINATION</span>
                                    <span class="socket-ip">@_selectedFrame.DestinationIp</span>
                                    <span class="socket-port">Port @(_selectedFrame.DestinationPort?.ToString() ?? "—")</span>
                                </div>
                            </div>
                        </div>

                        <div class="section-block">
                            <h4 class="section-title">Decoded protocol layers</h4>
                            @foreach (var group in _selectedFrame.Details.GroupBy(detail => detail.Layer))
                            {
                                <details class="packet-layer" open><summary>@group.Key</summary><dl>@foreach (var field in group) { <dt>@field.Name</dt><dd class="mono-text">@field.Value</dd> }</dl></details>
                            }
                        </div>

                        <!-- Payload Hex / ASCII View -->
                        @if (_selectedFrame.Payload != null && _selectedFrame.Payload.Length > 0)
                        {
                            <div class="section-block">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                    <h4 class="section-title" style="margin: 0;">Payload Bytes (@_selectedFrame.Payload.Length B)</h4>
                                    <button class="cli-copy-btn" @onclick="CopyPayloadHexAsync">📋 Copy Hex</button>
                                </div>
                                <pre class="hex-dump-box">@GenerateHexDump(_selectedFrame.Payload)</pre>
                            </div>
                        }
                        @if (_selectedFrame.RawData is { Length: > 0 } rawFrame)
                        {
                            <div class="section-block"><h4 class="section-title">Full captured frame (@rawFrame.Length bytes)</h4><pre class="hex-dump-box">@GenerateHexDump(rawFrame)</pre></div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="inspector-placeholder">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Radar())" />
                    <span style="font-weight: 600; color: var(--upuaut-sand);">Select a Frame to Inspect Wire Telemetry</span>
                    <span style="font-size: 0.8rem; color: var(--upuaut-text-dim); text-align: center; max-width: 280px;">
                        The Scout resolves process attribution and decodes transport headers and application payloads.
                    </span>
                </div>
            }
        </div>
    </div>
    }
</div>

@code {
    private IReadOnlyList<NetworkDeviceDescriptor> _devices = Array.Empty<NetworkDeviceDescriptor>();
    private string _selectedDeviceId = string.Empty;
    private bool _isCapturing;
    private bool _autoScroll = true;
    private PacketCaptureMode _captureMode = PacketCaptureMode.RawIpv4;

    private List<PacketFrame> _filteredFrames = new();
    private PacketFrame? _selectedFrame;

    private NetworkProtocol? _selectedProtocol;
    private string _selectedProcess = string.Empty;
    private string _searchFilter = string.Empty;
    private string _captureFilter = string.Empty;
    private string _displayFilter = string.Empty;
    private string _filterError = string.Empty;
    private string _activeView = "packets";
    private List<PacketConversation> _conversations = new();
    private string? _followStreamText;
    private IReadOnlyList<PacketFrame>? _offlineFrames;
    private List<string> _savedFilters = new();
    private bool _preferencesLoaded;
    private bool _useSharedTimeWindow = true;

    private ScoutStatistics _stats = new(0, 0, 0, new Dictionary<NetworkProtocol, int>(), new Dictionary<string, int>());
    private System.Threading.Timer? _refreshTimer;

    protected override void OnInitialized()
    {
        RefreshDevices();
        _selectedFrame = Investigation.SelectedFrame;

        ScoutService.PacketReceived += OnPacketReceived;

        // Periodic UI refresh ticker (200ms) to throttle rendering without dropping packets
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                RefreshUI();
                StateHasChanged();
            });
        }, null, 250, 250);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_preferencesLoaded)
        {
            _preferencesLoaded = true;
            try { _savedFilters = (await JSRuntime.InvokeAsync<string[]>("upuautPreferences.get", "upuaut.scout.filters")).ToList(); }
            catch { _savedFilters = new(); }
            StateHasChanged();
        }
    }

    private void OnCaptureModeChanged() => RefreshDevices();

    private void RefreshDevices()
    {
        var previousSelection = _selectedDeviceId;
        _devices = ScoutService.GetAvailableDevices(_captureMode);
        _selectedDeviceId = _devices.FirstOrDefault(device => device.Id.Equals(previousSelection, StringComparison.OrdinalIgnoreCase))?.Id
            ?? _devices.FirstOrDefault()?.Id
            ?? string.Empty;
        _filterError = _devices.Count == 0
            ? _captureMode == PacketCaptureMode.Ethernet
                ? "No Npcap-compatible capture devices were found. Install or repair Npcap, then refresh adapters."
                : "No active non-loopback IPv4 adapter was found. Connect an adapter or choose Ethernet/Npcap mode."
            : string.Empty;
    }

    private string AdapterHint => _captureMode == PacketCaptureMode.RawIpv4
        ? "Native IPv4 binds the selected local address; Administrator permission is required."
        : "Ethernet listens on the selected Npcap device; link and IP capabilities depend on the adapter.";

    private static string AdapterLabel(NetworkDeviceDescriptor device) => device.IpAddress is { Length: > 0 } address
        ? $"{device.Name} ({address})"
        : string.IsNullOrWhiteSpace(device.Description) || device.Description.Equals(device.Name, StringComparison.OrdinalIgnoreCase)
            ? device.Name
            : $"{device.Name} - {device.Description}";

    private async Task StartCaptureAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedDeviceId)) return;

        try
        {
            ScoutService.SetCaptureFilter(_captureFilter);
            await ScoutService.StartCaptureAsync(_selectedDeviceId, _captureMode);
            _isCapturing = true;
            RefreshUI();
        }
        catch (Exception ex)
        {
            _isCapturing = false;
            _filterError = $"Packet capture could not start: {ex.Message}";
        }
    }

    private async Task StopCaptureAsync()
    {
        try
        {
            await ScoutService.StopCaptureAsync();
            _isCapturing = false;
            RefreshUI();
        }
        catch (Exception ex) { _filterError = $"Packet capture could not stop cleanly: {ex.Message}"; }
    }

    private void ClearBuffer()
    {
        ScoutService.ClearBuffer();
        _filteredFrames.Clear();
        _selectedFrame = null;
        RefreshUI();
    }

    private void SetProtocol(NetworkProtocol? proto)
    {
        _selectedProtocol = proto;
        ApplyFilters();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _searchFilter = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        try
        {
            _filterError = string.Empty;
            var allMatches = QueryFilteredFrames();
            _filteredFrames = allMatches.OrderByDescending(f => f.Timestamp).Take(400).ToList();
            _conversations = PacketConversations.Group(allMatches).ToList();
        }
        catch (FormatException ex) { _filterError = ex.Message; }
        if (_autoScroll && _filteredFrames.Count > 0 && _selectedFrame == null)
        {
            _selectedFrame = _filteredFrames[0];
        }
    }

    private List<PacketFrame> QueryFilteredFrames()
    {
        var predicate = PacketDisplayFilter.Compile(_displayFilter);
        var source = _offlineFrames ?? ScoutService.GetRecentFrames(maxFrames: ScoutService.BufferCapacity);
        return source.Where(f => (!_selectedProtocol.HasValue || _selectedProtocol == NetworkProtocol.Unknown || MatchesProtocol(f, _selectedProtocol.Value))
            && (!_useSharedTimeWindow || (Investigation.Start is null || f.Timestamp >= Investigation.Start) && (Investigation.End is null || f.Timestamp <= Investigation.End))
            && (string.IsNullOrWhiteSpace(_selectedProcess) || f.ProcessName?.Equals(_selectedProcess, StringComparison.OrdinalIgnoreCase) == true)
            && (string.IsNullOrWhiteSpace(_searchFilter) || f.SourceIp.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) || f.DestinationIp.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) || f.Summary.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) || f.SourcePort?.ToString() == _searchFilter || f.DestinationPort?.ToString() == _searchFilter)
            && predicate(f)).ToList();
    }

    private static bool MatchesProtocol(PacketFrame frame, NetworkProtocol protocol) => protocol switch
    {
        NetworkProtocol.IPv6 => frame.CaptureLayer == "IPv6" || frame.Details.Any(detail => detail.Layer == "IPv6"),
        NetworkProtocol.IPv4 => frame.CaptureLayer == "IPv4" || frame.EtherType == 0x0800 || frame.Details.Any(detail => detail.Layer == "IPv4"),
        _ => frame.Protocol == protocol || frame.TransportProtocol == protocol
    };

    private void RefreshUI()
    {
        _stats = ScoutService.GetStatistics();
        ApplyFilters();
    }

    private void OnPacketReceived(object? sender, PacketFrame frame)
    {
        // Buffered by ScoutManager; timer handles UI refresh to prevent thread lock
    }

    private void SelectFrame(PacketFrame frame)
    {
        _selectedFrame = frame;
        Investigation.Select(frame);
    }

    private async Task CopyPayloadHexAsync()
    {
        var bytes = _selectedFrame?.RawData ?? _selectedFrame?.Payload;
        if (bytes == null) return;
        var hex = Convert.ToHexString(bytes);
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", hex);
    }

    private void SelectConversation(PacketConversation conversation)
    {
        _filteredFrames = conversation.Frames.OrderByDescending(f => f.Timestamp).ToList();
        _selectedFrame = _filteredFrames.FirstOrDefault(); _activeView = "packets";
        if (_selectedFrame is not null) Investigation.Select(_selectedFrame);
    }

    private void FollowStream(PacketConversation conversation)
    {
        _followStreamText = TcpStreamReassembler.Render(conversation);
        _filteredFrames = conversation.Frames.OrderByDescending(frame => frame.Timestamp).ToList();
        _selectedFrame = _filteredFrames.FirstOrDefault();
        if (_selectedFrame is not null) Investigation.Select(_selectedFrame);
        _activeView = "packets";
    }

    private async Task SaveFilterAsync()
    {
        if (string.IsNullOrWhiteSpace(_displayFilter)) return;
        try
        {
            _savedFilters = _savedFilters.Append(_displayFilter.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            await JSRuntime.InvokeVoidAsync("upuautPreferences.set", "upuaut.scout.filters", _savedFilters);
            _filterError = "Saved filter locally. Paste it into Display Filter to reuse it.";
        }
        catch { _filterError = "Could not save this filter in local storage."; }
    }

    private void OnSavedFilterSelected(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(selected)) { _displayFilter = selected; ApplyFilters(); }
    }

    private void OpenCapture()
    {
        var dialog = new OpenFileDialog { Filter = "PCAPNG capture (*.pcapng)|*.pcapng", CheckFileExists = true };
        if (dialog.ShowDialog() != true) return;
        try { _offlineFrames = PcapNgFile.Read(dialog.FileName); ApplyFilters(); if (_offlineFrames.Count == 250_000) _filterError = "Import reached the safety limit of 250,000 frames; save a smaller capture to inspect the remainder."; }
        catch (Exception ex) { _filterError = $"Could not open capture: {ex.Message}"; }
    }

    private void SaveCapture()
    {
        var dialog = new SaveFileDialog { Filter = "PCAPNG capture (*.pcapng)|*.pcapng", DefaultExt = ".pcapng", FileName = $"upuaut-{DateTime.Now:yyyyMMdd-HHmmss}.pcapng" };
        if (dialog.ShowDialog() != true) return;
        try { PcapNgFile.Write(dialog.FileName, QueryFilteredFrames()); }
        catch (Exception ex) { _filterError = $"Could not save capture: {ex.Message}"; }
    }

    private void CloseOfflineCapture() { _offlineFrames = null; ApplyFilters(); }

    private static string FormatPort(int? port) => port.HasValue ? $":{port.Value}" : "";

    private static string FormatBytes(long bytes)
    {
        if (bytes > 1024 * 1024 * 1024) return $"{(bytes / (1024.0 * 1024 * 1024)):F2} GB";
        if (bytes > 1024 * 1024) return $"{(bytes / (1024.0 * 1024)):F2} MB";
        if (bytes > 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{bytes} B";
    }

    private static string GetProtocolBadgeClass(NetworkProtocol proto) => proto switch
    {
        NetworkProtocol.TCP => "proto-tcp",
        NetworkProtocol.UDP => "proto-udp",
        NetworkProtocol.DNS => "proto-dns",
        NetworkProtocol.TLS => "proto-tls",
        NetworkProtocol.HTTP => "proto-http",
        NetworkProtocol.ICMP => "proto-icmp",
        NetworkProtocol.ICMPv6 => "proto-icmp",
        NetworkProtocol.IPv6 => "proto-other",
        _ => "proto-other"
    };

    private static string GenerateHexDump(byte[] data)
    {
        var sb = new StringBuilder();
        int bytesPerLine = 16;

        for (int i = 0; i < data.Length; i += bytesPerLine)
        {
            sb.Append($"{i:X4}  ");

            // Hex bytes
            for (int j = 0; j < bytesPerLine; j++)
            {
                if (i + j < data.Length)
                    sb.Append($"{data[i + j]:X2} ");
                else
                    sb.Append("   ");

                if (j == 7) sb.Append(' ');
            }

            sb.Append(" |");

            // ASCII representation
            for (int j = 0; j < bytesPerLine; j++)
            {
                if (i + j < data.Length)
                {
                    byte b = data[i + j];
                    sb.Append(b >= 32 && b <= 126 ? (char)b : '.');
                }
            }

            sb.AppendLine("|");
        }

        return sb.ToString();
    }

