@page "/chronicles"
@namespace Upuaut.UI.Pages
@inject IChroniclesService ChroniclesService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Upuaut — The Duat Chronicles</PageTitle>

<div class="chronicles-container">
    <!-- Top Filter & Control Header -->
    <div class="chronicles-header">
        <div class="header-titles">
            <h1 class="header-main-title">
                <span class="gold-accent">📜</span> The Duat Chronicles
            </h1>
            <span class="header-sub-title">
                Windows Event Log Triage, Anomaly Clustering &amp; Human-Readable Diagnostics
            </span>
        </div>

        <div class="header-actions-bar">
            <!-- View Mode Switcher -->
            <div class="view-mode-toggle">
                <button class="mode-btn @(_viewMode == ViewMode.Stream ? "mode-btn-active" : "")"
                        @onclick="@(() => SetViewMode(ViewMode.Stream))">
                    <span>≡</span> Stream View
                </button>
                <button class="mode-btn @(_viewMode == ViewMode.Clusters ? "mode-btn-active" : "")"
                        @onclick="@(() => SetViewMode(ViewMode.Clusters))">
                    <span>❖</span> Failure Clusters (@_clusters.Count)
                </button>
            </div>

            <!-- Channel Selector -->
            <div class="filter-group">
                <span class="filter-label">Channel:</span>
                <select class="upuaut-select" @bind="_filter.Channel" @bind:after="OnChannelChanged">
                    @foreach (var ch in _availableChannels)
                    {
                        <option value="@ch">@ch</option>
                    }
                </select>
            </div>

            <!-- Time Range -->
            <div class="filter-group">
                <span class="filter-label">Time:</span>
                <select class="upuaut-select" @bind="_filter.TimeRange" @bind:after="TriggerQueryAsync">
                    <option value="@LogTimeRange.LastHour">Last 1 Hour</option>
                    <option value="@LogTimeRange.Last24Hours">Last 24 Hours</option>
                    <option value="@LogTimeRange.Last7Days">Last 7 Days</option>
                    <option value="@LogTimeRange.Last30Days">Last 30 Days</option>
                    <option value="@LogTimeRange.AllTime">All Time</option>
                </select>
            </div>

            <!-- Query Button -->
            <FluentButton Appearance="ButtonAppearance.Primary"
                          IconStart="@(new Icons.Regular.Size16.ArrowClockwise())"
                          Loading="@_isLoading"
                          OnClick="TriggerQueryAsync">
                Query Logs
            </FluentButton>

            <!-- Offline EVTX Open Button -->
            <FluentButton Appearance="ButtonAppearance.Outline"
                          IconStart="@(new Icons.Regular.Size16.FolderOpen())"
                          OnClick="ToggleEvtxPrompt">
                Load .evtx
            </FluentButton>

            <!-- Live Stream Button -->
            <FluentButton Appearance="@(_isLiveStreaming ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                          IconStart="@(new Icons.Regular.Size20.Radar())"
                          OnClick="ToggleLiveStreamAsync">
                @(_isLiveStreaming ? "Live: Streaming" : "Live Stream")
            </FluentButton>
        </div>
    </div>

    <!-- Offline EVTX Path Input Bar (if open) -->
    @if (_showEvtxPrompt)
    {
        <div class="evtx-prompt-bar">
            <span class="gold-accent">📂 Offline EVTX:</span>
            <input type="text"
                   class="upuaut-search-input"
                   placeholder="Enter full path to .evtx file (e.g. C:\Diagnostics\System.evtx)"
                   style="flex: 1;"
                   @bind="_evtxFilePath" />
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="LoadCustomEvtxAsync">
                Load File
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ToggleEvtxPrompt">
                Cancel
            </FluentButton>
        </div>
    }

    <!-- Quick-Triage Presets Bar -->
    <div class="triage-presets-bar">
        <span class="preset-title">⚡ Quick Triage:</span>
        <button class="preset-btn" @onclick='@(() => ApplyPresetAsync("bsod"))' title="Kernel-Power 41, BugCheck 1001, WHEA hardware faults">
            <span>⚡</span> BSOD &amp; Reboots
        </button>
        <button class="preset-btn" @onclick='@(() => ApplyPresetAsync("crashes"))' title="Application Error 1000, SCM 7000/7031, .NET Runtime 1026">
            <span>💥</span> App &amp; Service Crashes
        </button>
        <button class="preset-btn" @onclick='@(() => ApplyPresetAsync("network"))' title="DNS-Client 1014, DHCP, Network timeouts">
            <span>🌐</span> Network &amp; DNS Drops
        </button>
        <button class="preset-btn" @onclick='@(() => ApplyPresetAsync("storage"))' title="Disk 7/11, NTFS 55/98 filesystem metadata corruptions">
            <span>💾</span> Disk &amp; Filesystem
        </button>
        <button class="preset-btn" @onclick='@(() => ApplyPresetAsync("security"))' title="Security Audit 4625 failed logons with decoded sub-status">
            <span>🔐</span> Failed Logons
        </button>
        <button class="preset-btn preset-btn-reset" @onclick='@(() => ApplyPresetAsync("reset"))' title="Reset filters to standard view">
            <span>🔄</span> Reset Filters
        </button>
    </div>

    <!-- Secondary Filter & Search Ribbon -->
    <div class="filter-ribbon">
        <!-- Severity Checkbox Pills -->
        <div class="level-pills">
            <span class="filter-label" style="margin-right: 0.25rem;">Severity:</span>
            <button class="pill-btn @(_filter.Levels.Contains(LogSeverityLevel.Critical) ? "pill-critical-active" : "")"
                    @onclick="@(() => ToggleLevel(LogSeverityLevel.Critical))">
                <span class="pill-dot red-dot"></span> Critical
            </button>
            <button class="pill-btn @(_filter.Levels.Contains(LogSeverityLevel.Error) ? "pill-error-active" : "")"
                    @onclick="@(() => ToggleLevel(LogSeverityLevel.Error))">
                <span class="pill-dot orange-dot"></span> Error
            </button>
            <button class="pill-btn @(_filter.Levels.Contains(LogSeverityLevel.Warning) ? "pill-warning-active" : "")"
                    @onclick="@(() => ToggleLevel(LogSeverityLevel.Warning))">
                <span class="pill-dot yellow-dot"></span> Warning
            </button>
            <button class="pill-btn @(_filter.Levels.Contains(LogSeverityLevel.Information) ? "pill-info-active" : "")"
                    @onclick="@(() => ToggleLevel(LogSeverityLevel.Information))">
                <span class="pill-dot blue-dot"></span> Info
            </button>
        </div>

        <!-- Provider Facet Filter -->
        @if (_topProviders.Count > 0)
        {
            <div class="filter-group">
                <span class="filter-label">Provider:</span>
                <select class="upuaut-select" @bind="_selectedProviderFacet" @bind:after="OnProviderFacetChanged">
                    <option value="">All Providers (@_topProviders.Count)</option>
                    @foreach (var (provider, count) in _topProviders)
                    {
                        <option value="@provider">@provider (@count)</option>
                    }
                </select>
            </div>
        }

        <!-- Benign Noise Filter Switch -->
        <div class="noise-filter-switch">
            <label class="switch-container">
                <input type="checkbox" @bind="_hideBenignNoise" />
                <span class="switch-label">Hide Benign Noise (DCOM 10016, HAL TAD)</span>
            </label>
        </div>

        <!-- Search Bar -->
        <div class="search-box-container">
            <span class="search-icon">🔍</span>
            <input type="text"
                   class="upuaut-search-input"
                   placeholder="Search message, provider, Event ID, error code (0x...)"
                   value="@_filter.SearchText"
                   @oninput="OnSearchInput" />
        </div>

        <!-- Export Dropdown -->
        <div class="export-actions">
            <FluentButton Appearance="ButtonAppearance.Outline"
                          IconStart="@(new Icons.Regular.Size16.ArrowDownload())"
                          OnClick="ExportReportAsync">
                Export Triage Report
            </FluentButton>
        </div>
    </div>

    <!-- Interactive Time Histogram -->
    <EventHistogram Logs="@FilteredLogs" BucketCount="24" />

    <!-- KPI Summary Row -->
    <div class="kpi-row">
        <div class="kpi-card">
            <span class="kpi-title">TOTAL EVENTS</span>
            <span class="kpi-value">@FilteredLogs.Count</span>
            <span class="kpi-sub">@(!string.IsNullOrEmpty(_loadedFile) ? Path.GetFileName(_loadedFile) : _filter.Channel)</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-title" style="color: #EF4444;">CRITICAL ISSUES</span>
            <span class="kpi-value" style="color: #EF4444;">@_criticalCount</span>
            <span class="kpi-sub">Kernel / Hardware faults</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-title" style="color: #F97316;">ERRORS</span>
            <span class="kpi-value" style="color: #F97316;">@_errorCount</span>
            <span class="kpi-sub">App crashes, service failures</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-title" style="color: #EAB308;">WARNINGS</span>
            <span class="kpi-value" style="color: #EAB308;">@_warningCount</span>
            <span class="kpi-sub">Timeouts &amp; notices</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-title" style="color: #10B981;">NOISE FILTERED</span>
            <span class="kpi-value" style="color: #10B981;">@_benignFilteredCount</span>
            <span class="kpi-sub">Suppressed harmless telemetry</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-title" style="color: var(--upuaut-gold);">FAILURE CLUSTERS</span>
            <span class="kpi-value" style="color: var(--upuaut-gold);">@_clusters.Count</span>
            <span class="kpi-sub">Distinct error signatures</span>
        </div>
    </div>

    <!-- Status banner if any -->
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="status-banner">
            <span class="gold-accent">ℹ</span> @_statusMessage
        </div>
    }

    <!-- Split Master-Detail Workspace -->
    <div class="workspace-split">
        <!-- Left: Stream View OR Cluster View -->
        <div class="logs-table-pane">
            @if (_isLoading)
            {
                <div class="loading-state">
                    <FluentSpinner Style="width: 48px; height: 48px;" />
                    <span>Consulting the Duat Chronicles...</span>
                </div>
            }
            else if (FilteredLogs.Count == 0)
            {
                <div class="empty-state">
                    <span style="font-size: 2rem;">🐺</span>
                    <span style="font-weight: 600; color: var(--upuaut-sand);">No Matching Events Found</span>
                    <span style="font-size: 0.85rem; color: var(--upuaut-text-dim);">
                        The selected channel and filter parameters returned zero records.
                    </span>
                </div>
            }
            else if (_viewMode == ViewMode.Clusters)
            {
                <EventClusterView Clusters="@_clusters"
                                  SelectedCluster="@_selectedCluster"
                                  OnClusterSelected="OnClusterSelected" />
            }
            else
            {
                <div class="table-scroll-container">
                    <table class="upuaut-table">
                        <thead>
                            <tr>
                                <th style="width: 85px;">Severity</th>
                                <th style="width: 135px;">Time</th>
                                <th style="width: 80px;">Event ID</th>
                                <th style="width: 175px;">Provider</th>
                                <th>Plain English Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in FilteredLogs)
                            {
                                var isSelected = _selectedLog?.RecordId == log.RecordId;
                                <tr class="log-row @(isSelected ? "row-selected" : "")"
                                    @onclick="@(() => SelectLog(log))">
                                    <td>
                                        <span class="severity-badge @GetSeverityClass(log.Level)">
                                            @log.Level.ToString()
                                        </span>
                                    </td>
                                    <td class="mono-text">@log.Timestamp.ToString("HH:mm:ss.fff")</td>
                                    <td class="mono-text gold-accent">@log.EventId</td>
                                    <td class="provider-cell" title="@log.ProviderName">@log.ProviderName</td>
                                    <td class="summary-cell">
                                        <div class="summary-preview">
                                            @if (log.Explanation != null && log.Explanation.IsCuratedKnowledge)
                                            {
                                                <span class="oracle-tag">✦ ORACLE</span>
                                            }
                                            @(log.Explanation?.Summary ?? log.Message)
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Right: The Oracle / Inspection Drawer -->
        <div class="oracle-pane">
            @if (_selectedLog != null)
            {
                <div class="oracle-card">
                    <div class="oracle-header">
                        <div class="oracle-title-row">
                            <span class="oracle-badge">
                                <span class="gold-accent">✦</span> THE ORACLE EXPLANATION
                            </span>
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <span class="triage-badge @GetTriageClass(_selectedLog.Explanation?.TriageRating)">
                                    @(_selectedLog.Explanation?.TriageRating.ToString() ?? "Standard")
                                </span>
                                <FluentButton Appearance="ButtonAppearance.Subtle"
                                              IconStart="@(new Icons.Regular.Size16.Copy())"
                                              Title="Copy as Markdown Bug Report"
                                              OnClick="CopyAsMarkdownBugAsync">
                                    Copy Bug
                                </FluentButton>
                            </div>
                        </div>

                        <h2 class="oracle-headline">
                            @(_selectedLog.Explanation?.Summary ?? "Windows Event Record")
                        </h2>

                        @if (!string.IsNullOrEmpty(_selectedLog.Explanation?.DecodedStatusCode))
                        {
                            <div class="status-code-chip">
                                <span class="gold-accent">Decoded Code:</span>
                                <code>@_selectedLog.Explanation.DecodedStatusCode</code>
                                <span style="color: var(--upuaut-text-muted);">— @_selectedLog.Explanation.StatusMeaning</span>
                            </div>
                        }

                        <!-- Oracle Inspection Tabs -->
                        <div class="oracle-tab-strip">
                            <button class="oracle-tab @(_activeTab == OracleTab.Overview ? "oracle-tab-active" : "")"
                                    @onclick="@(() => _activeTab = OracleTab.Overview)">
                                Overview &amp; Remediation
                            </button>
                            <button class="oracle-tab @(_activeTab == OracleTab.Properties ? "oracle-tab-active" : "")"
                                    @onclick="@(() => _activeTab = OracleTab.Properties)">
                                EventData (@_selectedLog.EventData.Count)
                            </button>
                            <button class="oracle-tab @(_activeTab == OracleTab.RawXml ? "oracle-tab-active" : "")"
                                    @onclick="@(() => _activeTab = OracleTab.RawXml)">
                                Raw Message &amp; XML
                            </button>
                        </div>
                    </div>

                    <div class="oracle-body">
                        @if (_activeTab == OracleTab.Overview)
                        {
                            <!-- Probable Causes -->
                            @if (_selectedLog.Explanation?.ProbableCauses.Count > 0)
                            {
                                <div class="section-block">
                                    <h4 class="section-title">Probable Causes</h4>
                                    <ul class="bullet-list">
                                        @foreach (var cause in _selectedLog.Explanation.ProbableCauses)
                                        {
                                            <li>@cause</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <!-- Recommended Actions -->
                            @if (_selectedLog.Explanation?.RecommendedActions.Count > 0)
                            {
                                <div class="section-block">
                                    <h4 class="section-title" style="color: #10B981;">Recommended Remediation</h4>
                                    <ul class="bullet-list checklist">
                                        @foreach (var action in _selectedLog.Explanation.RecommendedActions)
                                        {
                                            <li>@action</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <!-- Technical Coordinates -->
                            <div class="section-block">
                                <h4 class="section-title">Technical Coordinates</h4>
                                <div class="tech-grid">
                                    <div class="tech-item">
                                        <span class="tech-key">Event ID</span>
                                        <span class="tech-val mono-text gold-accent">@_selectedLog.EventId</span>
                                    </div>
                                    <div class="tech-item">
                                        <span class="tech-key">Provider</span>
                                        <span class="tech-val">@_selectedLog.ProviderName</span>
                                    </div>
                                    <div class="tech-item">
                                        <span class="tech-key">Timestamp (UTC)</span>
                                        <span class="tech-val mono-text">@_selectedLog.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</span>
                                    </div>
                                    <div class="tech-item">
                                        <span class="tech-key">Channel / Source</span>
                                        <span class="tech-val">@(_selectedLog.SourceFile ?? _selectedLog.Channel)</span>
                                    </div>
                                    <div class="tech-item">
                                        <span class="tech-key">Process ID</span>
                                        <span class="tech-val mono-text">@(_selectedLog.ProcessId?.ToString() ?? "N/A")</span>
                                    </div>
                                    <div class="tech-item">
                                        <span class="tech-key">Computer</span>
                                        <span class="tech-val">@(_selectedLog.ComputerName ?? "LocalHost")</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (_activeTab == OracleTab.Properties)
                        {
                            <EventPropertyGrid Properties="@_selectedLog.EventData" />
                        }
                        else if (_activeTab == OracleTab.RawXml)
                        {
                            <div class="section-block">
                                <h4 class="section-title">Raw Windows Event Message</h4>
                                <pre class="raw-box">@_selectedLog.Message</pre>
                            </div>

                            @if (!string.IsNullOrEmpty(_selectedLog.RawXml))
                            {
                                <div class="section-block">
                                    <h4 class="section-title">Raw XML Payload</h4>
                                    <pre class="raw-box xml-box">@_selectedLog.RawXml</pre>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="oracle-placeholder">
                    <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletListMultiple())" />
                    <span style="font-weight: 600; color: var(--upuaut-sand);">Select an Event to Consult the Oracle</span>
                    <span style="font-size: 0.8rem; color: var(--upuaut-text-dim); text-align: center; max-width: 280px;">
                        Upuaut decodes status codes, maps known issues, and translates cryptic Windows errors into actionable root causes.
                    </span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private enum ViewMode { Stream, Clusters }
    private enum OracleTab { Overview, Properties, RawXml }

    private ViewMode _viewMode = ViewMode.Stream;
    private OracleTab _activeTab = OracleTab.Overview;

    private LogFilterOptions _filter = new();
    private List<LogRecord> _allLogs = new();
    private IReadOnlyList<EventCluster> _clusters = Array.Empty<EventCluster>();
    private EventCluster? _selectedCluster;
    private LogRecord? _selectedLog;
    private bool _isLoading;
    private bool _isLiveStreaming;
    private bool _hideBenignNoise = true;
    private string _statusMessage = string.Empty;
    private IReadOnlyList<string> _availableChannels = Array.Empty<string>();
    private List<(string Provider, int Count)> _topProviders = new();
    private string _selectedProviderFacet = string.Empty;

    private bool _showEvtxPrompt;
    private string _evtxFilePath = string.Empty;
    private string? _loadedFile;

    private int _criticalCount;
    private int _errorCount;
    private int _warningCount;
    private int _benignFilteredCount;

    protected override async Task OnInitializedAsync()
    {
        ChroniclesService.LogReceived += OnLiveLogReceived;
        ChroniclesService.StatusChanged += OnServiceStatusChanged;

        _availableChannels = ChroniclesService.GetAvailableChannels();
        await TriggerQueryAsync();
    }

    private void SetViewMode(ViewMode mode)
    {
        _viewMode = mode;
    }

    private void ToggleEvtxPrompt()
    {
        _showEvtxPrompt = !_showEvtxPrompt;
    }

    private async Task LoadCustomEvtxAsync()
    {
        if (string.IsNullOrWhiteSpace(_evtxFilePath)) return;

        _isLoading = true;
        _loadedFile = _evtxFilePath;
        _showEvtxPrompt = false;
        StateHasChanged();

        try
        {
            var logs = await ChroniclesService.LoadEvtxFileAsync(_evtxFilePath, _filter);
            _allLogs = logs.ToList();
            ProcessLogs();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnChannelChanged()
    {
        _loadedFile = null;
        await TriggerQueryAsync();
    }

    private async Task ApplyPresetAsync(string presetName)
    {
        _loadedFile = null;
        _selectedProviderFacet = string.Empty;
        _filter.SelectedProviders = null;

        switch (presetName)
        {
            case "bsod":
                _filter.Channel = "System";
                _filter.Levels = new HashSet<LogSeverityLevel> { LogSeverityLevel.Critical };
                _filter.SearchText = "";
                _filter.TimeRange = LogTimeRange.Last7Days;
                break;
            case "crashes":
                _filter.Channel = "Application";
                _filter.Levels = new HashSet<LogSeverityLevel> { LogSeverityLevel.Critical, LogSeverityLevel.Error };
                _filter.SearchText = "";
                _filter.TimeRange = LogTimeRange.Last7Days;
                break;
            case "network":
                _filter.Channel = "System";
                _filter.Levels = new HashSet<LogSeverityLevel> { LogSeverityLevel.Warning, LogSeverityLevel.Error };
                _filter.SearchText = "DNS-Client";
                _filter.TimeRange = LogTimeRange.Last7Days;
                break;
            case "storage":
                _filter.Channel = "System";
                _filter.Levels = new HashSet<LogSeverityLevel> { LogSeverityLevel.Warning, LogSeverityLevel.Error, LogSeverityLevel.Critical };
                _filter.SearchText = "Disk";
                _filter.TimeRange = LogTimeRange.Last30Days;
                break;
            case "security":
                _filter.Channel = "Security";
                _filter.Levels = new HashSet<LogSeverityLevel> { LogSeverityLevel.Information, LogSeverityLevel.Error, LogSeverityLevel.Warning, LogSeverityLevel.Critical };
                _filter.SearchText = "4625";
                _filter.TimeRange = LogTimeRange.Last7Days;
                break;
            case "reset":
            default:
                _filter.Channel = "System";
                _filter.Levels = new HashSet<LogSeverityLevel> { LogSeverityLevel.Critical, LogSeverityLevel.Error, LogSeverityLevel.Warning };
                _filter.SearchText = "";
                _filter.TimeRange = LogTimeRange.Last24Hours;
                break;
        }

        await TriggerQueryAsync();
    }

    private void ToggleLevel(LogSeverityLevel level)
    {
        if (_filter.Levels.Contains(level))
        {
            if (_filter.Levels.Count > 1)
            {
                _filter.Levels.Remove(level);
            }
        }
        else
        {
            _filter.Levels.Add(level);
        }

        ProcessLogs();
    }

    private void OnProviderFacetChanged()
    {
        if (string.IsNullOrWhiteSpace(_selectedProviderFacet))
        {
            _filter.SelectedProviders = null;
        }
        else
        {
            _filter.SelectedProviders = new HashSet<string> { _selectedProviderFacet };
        }

        ProcessLogs();
    }

    private async Task TriggerQueryAsync()
    {
        _isLoading = true;
        _selectedLog = null;
        StateHasChanged();

        try
        {
            var logs = await ChroniclesService.QueryEventLogsAsync(_filter);
            _allLogs = logs.ToList();
            ProcessLogs();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleLiveStreamAsync()
    {
        if (_isLiveStreaming)
        {
            await ChroniclesService.StopLiveStreamAsync();
            _isLiveStreaming = false;
        }
        else
        {
            await ChroniclesService.StartLiveStreamAsync(_filter.Channel, _filter.Levels);
            _isLiveStreaming = true;
        }
    }

    private void OnLiveLogReceived(object? sender, LogRecord log)
    {
        InvokeAsync(() =>
        {
            _allLogs.Insert(0, log);
            ProcessLogs();
            StateHasChanged();
        });
    }

    private void OnServiceStatusChanged(object? sender, string status)
    {
        InvokeAsync(() =>
        {
            _statusMessage = status;
            StateHasChanged();
        });
    }

    private void SelectLog(LogRecord log)
    {
        _selectedLog = log;
    }

    private void OnClusterSelected(EventCluster cluster)
    {
        _selectedCluster = cluster;
        _selectedLog = cluster.Exemplar;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _filter.SearchText = e.Value?.ToString();
        ProcessLogs();
    }

    private List<LogRecord> FilteredLogs
    {
        get
        {
            var query = _allLogs.Where(l => _filter.Levels.Contains(l.Level));

            if (_hideBenignNoise)
            {
                query = query.Where(l => l.Explanation?.TriageRating != TriageSeverity.BenignNoise);
            }

            if (!string.IsNullOrWhiteSpace(_selectedProviderFacet))
            {
                query = query.Where(l => l.ProviderName.Equals(_selectedProviderFacet, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_filter.SearchText))
            {
                var s = _filter.SearchText.Trim();
                query = query.Where(l =>
                    l.Message.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    l.ProviderName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    l.EventId.ToString().Contains(s) ||
                    (l.Explanation?.Summary.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (l.Explanation?.DecodedStatusCode?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query.ToList();
        }
    }

    private void ProcessLogs()
    {
        _criticalCount = _allLogs.Count(l => l.Level == LogSeverityLevel.Critical);
        _errorCount = _allLogs.Count(l => l.Level == LogSeverityLevel.Error);
        _warningCount = _allLogs.Count(l => l.Level == LogSeverityLevel.Warning);
        _benignFilteredCount = _allLogs.Count(l => l.Explanation?.TriageRating == TriageSeverity.BenignNoise);

        // Compute top providers for facet navigation
        _topProviders = _allLogs
            .GroupBy(l => l.ProviderName)
            .OrderByDescending(g => g.Count())
            .Take(12)
            .Select(g => (g.Key, g.Count()))
            .ToList();

        // Cluster active filtered logs
        _clusters = ChroniclesService.ClusterLogs(FilteredLogs);

        if (_selectedLog == null || !FilteredLogs.Any(l => l.RecordId == _selectedLog.RecordId))
        {
            _selectedLog = FilteredLogs.FirstOrDefault();
        }

        StateHasChanged();
    }

    private async Task CopyAsMarkdownBugAsync()
    {
        if (_selectedLog == null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"### 🐛 [{_selectedLog.Level}] Event {_selectedLog.EventId} — {_selectedLog.ProviderName}");
        sb.AppendLine($"- **Timestamp:** `{_selectedLog.Timestamp:yyyy-MM-dd HH:mm:ss.fff UTC}`");
        sb.AppendLine($"- **Triage Rating:** `{_selectedLog.Explanation?.TriageRating}`");
        sb.AppendLine($"- **Oracle Summary:** {_selectedLog.Explanation?.Summary}");

        if (!string.IsNullOrEmpty(_selectedLog.Explanation?.DecodedStatusCode))
        {
            sb.AppendLine($"- **Decoded Code:** `{_selectedLog.Explanation.DecodedStatusCode}` ({_selectedLog.Explanation.StatusMeaning})");
        }

        if (_selectedLog.Explanation?.RecommendedActions.Count > 0)
        {
            sb.AppendLine("\n**Actionable Remediation:**");
            foreach (var act in _selectedLog.Explanation.RecommendedActions)
            {
                sb.AppendLine($"- [ ] {act}");
            }
        }

        sb.AppendLine("\n```text");
        sb.AppendLine(_selectedLog.Message);
        sb.AppendLine("```");

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        _statusMessage = "Copied event details as Markdown bug report to clipboard!";
    }

    private async Task ExportReportAsync()
    {
        var md = ChroniclesService.ExportLogs(FilteredLogs, LogExportFormat.Markdown);
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", md);
        _statusMessage = $"Exported complete triage report ({FilteredLogs.Count} events) to clipboard!";
    }

    private static string GetSeverityClass(LogSeverityLevel level) => level switch
    {
        LogSeverityLevel.Critical => "severity-critical",
        LogSeverityLevel.Error => "severity-error",
        LogSeverityLevel.Warning => "severity-warning",
        LogSeverityLevel.Information => "severity-info",
        _ => "severity-verbose"
    };

    private static string GetTriageClass(TriageSeverity? severity) => severity switch
    {
        TriageSeverity.Critical => "triage-critical",
        TriageSeverity.High => "triage-high",
        TriageSeverity.Medium => "triage-medium",
        TriageSeverity.Low => "triage-low",
        TriageSeverity.BenignNoise => "triage-benign",
        _ => "triage-medium"
    };

    public void Dispose()
    {
        ChroniclesService.LogReceived -= OnLiveLogReceived;
        ChroniclesService.StatusChanged -= OnServiceStatusChanged;
        if (_isLiveStreaming)
        {
            ChroniclesService.StopLiveStreamAsync().GetAwaiter().GetResult();
        }
    }
}
