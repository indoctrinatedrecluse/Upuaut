@page "/weigher"
@namespace Upuaut.UI.Pages
@inject NavigationManager Navigation

<PageTitle>Upuaut — The Scales of Ma'at · Work in Progress</PageTitle>

<div class="wip-backdrop" role="presentation">
    <section class="wip-dialog" role="dialog" aria-modal="true" aria-labelledby="wip-title">
        <div class="wip-sigil" aria-hidden="true">⚖</div>
        <span class="wip-kicker">THE SCALES // DEVELOPMENT CHAMBER</span>
        <h1 id="wip-title">This subsystem is still in progress</h1>
        <p>
            Ma’at’s Triage interface is under active development. Its correlation and anomaly-scoring features are not
            available yet, so this page does not display live findings.
        </p>
        <div class="wip-status"><span></span> WORK IN PROGRESS <b>·</b> NOT AVAILABLE IN THIS BUILD</div>
        <button class="wip-return" @onclick="ReturnToDashboard">Return to the dashboard <span aria-hidden="true">→</span></button>
    </section>
</div>

@code {
    private void ReturnToDashboard() => Navigation.NavigateTo("/");
}
