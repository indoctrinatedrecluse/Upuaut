@page "/docs"
@page "/documentation"
@namespace Upuaut.UI.Pages
@inject IJSRuntime JSRuntime

<PageTitle>Upuaut — System Documentation &amp; Architecture Reference</PageTitle>

<div class="docs-container">
    <!-- Header Banner -->
    <div class="docs-hero">
        <div class="docs-hero-badge">
            <span class="gold-accent">📖</span> SESHTAU — SACRED SPECIFICATIONS &amp; MANUAL
        </div>
        <h1 class="docs-title">
            Upuaut <span class="gold-accent">System Documentation</span>
        </h1>
        <p class="docs-subtitle">
            Searchable user and developer reference for event-log review, packet capture, troubleshooting, and the Upuaut project structure.
        </p>

        <!-- Search & Category Filter Bar -->
        <div class="docs-search-bar">
            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input type="text"
                       class="docs-search-field"
                       placeholder="Search documentation (e.g. SIO_RCVALL, BSOD, iphlpapi, run.ps1, VS 2026)..."
                       @bind="_searchQuery"
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_searchQuery))
                {
                    <button class="clear-search-btn" @onclick="@(() => _searchQuery = "")">✕</button>
                }
            </div>

            <div class="docs-category-chips">
                <button class="cat-chip @(_selectedCategory == "all" ? "active" : "")" @onclick='@(() => _selectedCategory = "all")'>All Sections</button>
                <button class="cat-chip @(_selectedCategory == "getting-started" ? "active" : "")" @onclick='@(() => _selectedCategory = "getting-started")'>Getting Started</button>
                <button class="cat-chip @(_selectedCategory == "arch" ? "active" : "")" @onclick='@(() => _selectedCategory = "arch")'>Architecture &amp; .NET 10</button>
                <button class="cat-chip @(_selectedCategory == "chronicles" ? "active" : "")" @onclick='@(() => _selectedCategory = "chronicles")'>The Duat Chronicles</button>
                <button class="cat-chip @(_selectedCategory == "scout" ? "active" : "")" @onclick='@(() => _selectedCategory = "scout")'>The Scout (Packet Capture)</button>
                <button class="cat-chip @(_selectedCategory == "diagnostics" ? "active" : "")" @onclick='@(() => _selectedCategory = "diagnostics")'>Crash Reporter &amp; Logs</button>
                <button class="cat-chip @(_selectedCategory == "vs2026" ? "active" : "")" @onclick='@(() => _selectedCategory = "vs2026")'>Development Guide</button>
                <button class="cat-chip @(_selectedCategory == "cli" ? "active" : "")" @onclick='@(() => _selectedCategory = "cli")'>CLI &amp; Automation</button>
            </div>
        </div>
    </div>

    <!-- Documentation Sections -->
    <div class="docs-content-layout">
        <div class="docs-articles">
            @if (!FilteredArticles.Any())
            {
                <div class="no-docs-results">
                    <span class="empty-icon">📜</span>
                    <h3>No matching documentation found</h3>
                    <p>Try searching with another keyword like "sockets", "crash", "ETW", or clear the search query.</p>
                </div>
            }

            @foreach (var article in FilteredArticles)
            {
                <article class="doc-card" id="@article.Id">
                    <div class="doc-card-header">
                        <div class="doc-badge-row">
                            <span class="doc-cat-badge">@article.CategoryName</span>
                            <span class="doc-section-id">#@article.Id</span>
                        </div>
                        <h2 class="doc-heading">@article.Title</h2>
                        <p class="doc-summary">@article.Summary</p>
                    </div>

                    <div class="doc-body">
                        @((MarkupString)article.HtmlContent)
                    </div>
                </article>
            }
        </div>

        <!-- Sticky Table of Contents Sidebar -->
        <aside class="docs-toc-sidebar">
            <div class="toc-header">
                <span class="gold-accent">✦</span> TABLE OF CONTENTS
            </div>
            <nav class="toc-nav">
                @foreach (var article in FilteredArticles)
                {
                    <a href="#@article.Id" class="toc-link">
                        <span class="toc-icon">@article.Icon</span>
                        <span class="toc-text">@article.Title</span>
                    </a>
                }
            </nav>
            <div class="toc-footer">
                <span class="toc-note">Upuaut User &amp; Developer Guide v0.1.0</span>
                <span class="toc-note">Author: Abhishek Mitra</span>
            </div>
        </aside>
    </div>
</div>

@code {
    private string _searchQuery = "";
    private string _selectedCategory = "all";

    private IEnumerable<DocArticle> FilteredArticles
    {
        get
        {
            var items = _articles.AsEnumerable();

            if (_selectedCategory != "all")
            {
                items = items.Where(a => a.Category.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim();
                items = items.Where(a =>
                    a.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    a.Summary.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    a.RawText.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return items;
        }
    }

    private record DocArticle(
        string Id,
        string Category,
        string CategoryName,
        string Title,
        string Summary,
        string Icon,
        string HtmlContent,
        string RawText
    );

    private readonly List<DocArticle> _articles = new()
    {
        new(
            Id: "getting-started",
            Category: "getting-started",
            CategoryName: "Getting Started",
            Title: "Using Upuaut",
            Summary: "A short guide to the dashboard, Chronicles event-log review, Scout packet capture, and the current Triage status.",
            Icon: "✦",
            HtmlContent: @"
                <p>Upuaut is a Windows desktop toolkit for reviewing local Windows event logs and inspecting network traffic. The dashboard links to each workspace; Help in the top bar opens a searchable quick guide and About.</p>
                <h4>Review event logs with Chronicles</h4>
                <ol>
                    <li>Choose a channel and time range, then select <strong>Query Logs</strong>.</li>
                    <li>Filter by severity, provider, or search text. Quick Triage presets cover common crash, network, storage, and security investigations.</li>
                    <li>Use Event ID, Provider, severity, time range, and search together. Failure Clusters group records by provider, event ID, severity, and a normalized message prefix.</li>
                    <li>Select an event to inspect it, save/load an investigation JSON case, or export filtered JSON/CSV.</li>
                    <li>To inspect an offline log, select <strong>Load .evtx</strong> and enter its full file path.</li>
                </ol>
                <h4>Inspect network traffic with Scout</h4>
                <ol>
                    <li>Choose an adapter and a capture mode before starting.</li>
                    <li><strong>Native IPv4</strong> uses Windows raw sockets and requires administrator privileges. <strong>Ethernet</strong> uses Npcap and captures link-layer frames.</li>
                    <li>Optionally enter a capture filter such as <code>tcp.port == 443</code> before starting. This is evaluated in user space before packets enter Scout's buffer.</li>
                    <li>Use the display filter for buffered packets. For example: <code>ip.src == 10.0.0.5 &amp;&amp; tcp.port == 443</code>, <code>dns.qry.name contains example</code>, <code>tls</code>, or <code>process contains chrome</code>.</li>
                    <li>Select a packet to inspect the decoded layer tree and full captured bytes. Conversations can be grouped by endpoints; TCP Follow shows sequence-ordered bytes and marks capture gaps.</li>
                    <li>Open or save PCAPNG files. Imports support Ethernet and raw IPv4/IPv6 and stop at 250,000 frames. The live FIFO buffer holds up to 15,000 frames.</li>
                    <li>Use <strong>Stop Capture</strong> to end collection; <strong>Clear</strong> clears the live in-memory buffer. Ctrl+1/2/3 navigates to Chronicles, Scout, and Scales.</li>
                </ol>
                <p>Capture visibility depends on adapter, permissions, and mode. Capture filters do not configure Npcap/kernel filtering. TLS payloads remain encrypted; process attribution is best effort for local IPv4 sockets.</p>
                <h4>Triage status</h4>
                <p>The Scales route places recent warning/error events beside packets already in Scout's buffer. Its percentage is only normalized time proximity within ±2.5 seconds, not causal confidence. Notes and the full event/packet matches can be saved as a case JSON or CSV.</p>
            ",
            RawText: "getting started user guide dashboard Chronicles event logs query severity provider event ID saved investigation JSON CSV preset clusters export evtx Scout packet capture adapter Raw IPv4 administrator Ethernet Npcap capture display filter IPv6 PCAPNG TCP follow stream conversation raw bytes shared time keyboard shortcuts Triage correlation preview notes temporal proximity"
        ),
        new(
            Id: "in-process-blazor-hybrid",
            Category: "arch",
            CategoryName: "Architecture & Runtime",
            Title: "In-Process Blazor Hybrid Architecture",
            Summary: "Why Upuaut executes the frontend and backend in a unified in-process model, eliminating IPC overhead and unlocking raw Win32 pointer speed.",
            Icon: "⚡",
            HtmlContent: @"
                <p>Traditional diagnostic tools and web-wrapper desktop apps (such as Electron or Tauri) segregate the user interface and native OS services across separate processes communicating over JSON-RPC or WebSocket IPC channels. For real-time forensic triage—where the OS may generate thousands of packet frames and ETW log entries per second—this architecture incurs severe serialization latency and memory copy penalties.</p>
                
                <h4>The Upuaut In-Process Philosophy</h4>
                <p>Upuaut runs <strong>in-process</strong> using <strong>Microsoft Blazor Hybrid with WPF and Microsoft WebView2</strong> on <strong>.NET 10 LTS</strong>. The C# business logic, native Win32 sockets, and the Blazor WebAssembly/HTML rendering loop share the same managed heap and address space:</p>
                <ul>
                    <li><strong>Direct Memory Pointers:</strong> Raw packet byte arrays captured via Win32 sockets are stored in zero-allocation ring buffers and directly sliced for UI hex-dump inspection without crossing process boundaries.</li>
                    <li><strong>Hardware Accelerated Rendering:</strong> WebView2 utilizes the system Chromium engine backed by Direct3D hardware acceleration for fluid 120 FPS data grid scrolling.</li>
                    <li><strong>Direct Win32 API Interop:</strong> Upuaut calls <code>iphlpapi.dll</code>, <code>advapi32.dll</code>, and <code>wevtapi.dll</code> directly via P/Invoke with zero proxy services or inter-process daemons.</li>
                </ul>
            ",
            RawText: "In-Process Blazor Hybrid Architecture WPF WebView2 .NET 10 LTS Win32 PInvoke iphlpapi advapi32 zero-allocation ring buffer"
        ),

        new(
            Id: "the-duat-chronicles",
            Category: "chronicles",
            CategoryName: "Duat Chronicles",
            Title: "The Duat Chronicles & Forensic Event Log Engine",
            Summary: "Streaming Windows Event Log parser using native EventLogReader, XPath optimization, and deep forensic error explanation.",
            Icon: "📜",
            HtmlContent: @"
                <p>The standard Windows Event Viewer (<code>eventvwr.msc</code>) is notorious for slow, blocking scans, cryptic error messages, and an overwhelming flood of noise. The Duat Chronicles revolutionizes Windows log analysis through structured, high-speed parsing.</p>
                
                <h4>1. Optimized XPath Queries</h4>
                <p>Instead of reading logs sequentially, Upuaut uses compiled XPath expressions evaluated directly by the Windows Eventing kernel subsystem (<code>wevtapi.dll</code>):</p>
                <pre class=""docs-code""><code>*[System[(Level=1 or Level=2) and TimeCreated[timediff(@SystemTime) &lt;= 86400000]]]</code></pre>
                <p>This allows scanning 50,000+ entries in under 200 milliseconds, fetching only Critical and Error events from the last 24 hours.</p>

                <h4>2. Quick-Triage Presets</h4>
                <p>One-click filters isolate the most urgent OS failures:</p>
                <ul>
                    <li><strong>⚡ BSOD &amp; BugChecks:</strong> Extracts Event 1001 (WER-SystemErrorReporting) and Event 41 (Kernel-Power).</li>
                    <li><strong>💥 App Crashes:</strong> Isolates Event 1000 (Application Error) and Event 1026 (.NET Runtime).</li>
                    <li><strong>🌐 Network &amp; DNS:</strong> Catches Event 1014 (DNS Client Resolution Timeout) and NetBT failures.</li>
                    <li><strong>💾 Disk &amp; Storage:</strong> Identifies NTFS corruption, bad blocks (Event 7 / Disk), and StorAHCI timeouts.</li>
                    <li><strong>🔐 Security:</strong> Tracks Event 4625 (Failed Logons) with Logon Type 2/3/10 and Sub-Status codes.</li>
                </ul>

                <h4>3. The Oracle Explanation &amp; 1-Click Remediation</h4>
                <p>Every identified error is paired with a plain-English diagnosis, root cause hypothesis, and an immediate PowerShell command (such as DISM, SFC, or Netsh) ready to copy and execute.</p>

                <h4>4. Structured queries, presets &amp; cases</h4>
                <p>Use Event ID, provider, severity, channel, time range (including a custom start/end), and free text together. Save a named filter preset in this Windows user profile for repeated queries. Save an investigation JSON case to preserve the filter and displayed event records; load it later to continue offline review. Filtered records can be exported as JSON or CSV.</p>
                <p>Failure Clusters are grouped by provider, event ID, severity, and the first 80 characters of a message after replacing numbers and GUIDs. A repeated signature is a useful grouping clue, not proof of a common cause.</p>
            ",
            RawText: "The Duat Chronicles EventLogReader XPath optimization structured Event ID provider custom time named filter presets investigation JSON case export CSV failure clusters grouping signature"
        ),

        new(
            Id: "the-scout-packet-capture",
            Category: "scout",
            CategoryName: "The Scout",
            Title: "The Scout: Driverless Packet Capture & Process Attribution",
            Summary: "Native IPv4 raw socket capture plus optional Npcap Ethernet capture, protocol filtering, packet inspection, and best-effort process attribution.",
            Icon: "📡",
            HtmlContent: @"
                <p>Scout provides two capture modes. Native IPv4 uses Windows raw sockets without an added capture driver. Ethernet mode uses Npcap to capture link-layer frames.</p>

                <h4>1. Driverless Capture via SIO_RCVALL</h4>
                <p>When running with administrative privileges, Upuaut binds a standard .NET <code>System.Net.Sockets.Socket</code> configured as:</p>
                <pre class=""docs-code""><code>var socket = new Socket(AddressFamily.InterNetwork, SocketType.Raw, ProtocolType.IP);
socket.Bind(new IPEndPoint(localIp, 0));
socket.IOControl(IOControlCode.ReceiveAll, new byte[] { 1, 0, 0, 0 }, new byte[] { 1, 0, 0, 0 });</code></pre>
                <p>This asks the Windows TCP/IP stack to deliver IPv4 traffic visible to the selected interface. Raw-socket access requires elevated permissions; adapter and Windows filtering affect which traffic is visible.</p>

                <h4>2. Optional Ethernet Capture</h4>
                <p>Select <strong>Ethernet frames (Npcap)</strong> when Npcap is installed and its capture service is available. It exposes Ethernet/VLAN details and dissects IPv4, IPv6 extension headers, ARP, TCP, UDP, and ICMPv6. Raw socket mode remains IPv4-only.</p>

                <h4>3. Process Attribution (iphlpapi.dll)</h4>
                <p>Scout consults the Windows TCP and UDP endpoint tables to associate packets with local processes where a current socket matches the packet endpoints. Attribution may be unavailable for unmatched or closed sockets. Resolved details can include:</p>
                <ul>
                    <li>Process ID (PID) and Process Name (e.g. <code>chrome.exe</code>, <code>teams.exe</code>, <code>svchost.exe</code>).</li>
                    <li>Full executable image path on disk.</li>
                    <li>Active TCP state (Established, TimeWait, CloseWait, Listen).</li>
                </ul>

                <h4>4. Filters, conversations &amp; packet inspection</h4>
                <p>Capture filters are user-space predicates applied before buffering; they do not reduce packets delivered by the capture backend. Display filters support common fields joined with <code>&amp;&amp;</code>: <code>ip.src == 10.0.0.5</code>, <code>tcp.port == 443</code>, <code>udp.dstport == 53</code>, <code>dns.qry.name contains example</code>, <code>tls</code>, and <code>process contains chrome</code>. Unsupported syntax is reported inline.</p>
                <p>The bounded live ring buffer retains 15,000 frames and reports FIFO overwrites, user-space filtered frames, parser rejects, and socket errors. Conversations group the filtered packets by endpoint pair. TCP Follow orders segments by sequence number, trims overlaps, and marks sequence gaps; it cannot restore packets that were never captured. TLS bytes remain encrypted.</p>
                <p>Open and save PCAPNG captures using Ethernet or raw IP link types. Imports accept IPv4/IPv6 raw packets and Ethernet, and are limited to 250,000 frames. The packet inspector shows decoded fields and full frame bytes.</p>
            ",
            RawText: "The Scout Packet Capture SIO_RCVALL raw sockets driverless Ethernet Npcap IPv4 IPv6 ARP ICMPv6 TCP UDP DNS TLS filters capture display PCAPNG pcap follow stream conversation ring buffer IP Helper best effort PID attribution"
        ),

        new(
            Id: "diagnostics-and-crash-reporting",
            Category: "diagnostics",
            CategoryName: "Diagnostics & Telemetry",
            Title: "App Diagnostics & Forensic Crash Reporting",
            Summary: "Comprehensive telemetry system with in-memory breadcrumbs, rolling JSONL logs, and multi-threaded crash trapping.",
            Icon: "🛡️",
            HtmlContent: @"
                <p>Upuaut is designed with industrial-grade resilience. Diagnostic and forensic crash data are recorded continuously so that any failure can be analyzed post-mortem.</p>

                <h4>1. Multi-Threaded Crash Hooks</h4>
                <p>Upuaut traps unhandled exceptions across three critical lifecycle layers in <code>App.xaml.cs</code>:</p>
                <ul>
                    <li><code>WpfApp.DispatcherUnhandledException</code>: Traps UI thread faults without tearing down the native window.</li>
                    <li><code>AppDomain.CurrentDomain.UnhandledException</code>: Catches worker thread and background task exceptions.</li>
                    <li><code>TaskScheduler.UnobservedTaskException</code>: Intercepts unobserved asynchronous faults.</li>
                </ul>

                <h4>2. Forensic Dump Vault</h4>
                <p>When an unhandled exception occurs, Upuaut writes a comprehensive forensic dump under <code>%LocalAppData%\Upuaut\Crashes</code> containing:</p>
                <ul>
                    <li><strong>Machine &amp; OS Telemetry:</strong> Windows Build, .NET runtime version, CPU architecture, elevation status, and physical RAM footprint.</li>
                    <li><strong>Exception Stack Trace:</strong> Full inner exception chain with source file line numbers.</li>
                    <li><strong>Historical Breadcrumbs:</strong> The last 250 in-memory diagnostic events leading up to the exact millisecond of failure.</li>
                </ul>

                <h4>3. Daily Rolling Logs</h4>
                <p>Telemetry is written to <code>%LocalAppData%\Upuaut\Logs\upuaut-YYYY-MM-DD.jsonl</code>. Each entry is a single-line JSON object containing timestamps, thread IDs, log levels, calling methods, and telemetry payloads.</p>
            ",
            RawText: "Crash Reporter Diagnostics Telemetry LocalAppData Upuaut Crashes Logs JSONL Breadcrumbs Dispatcher AppDomain TaskScheduler"
        ),

        new(
            Id: "visual-studio-2026-guide",
            Category: "vs2026",
            CategoryName: "Visual Studio 2026",
            Title: "Visual Studio 2026 Enterprise Edition Developer Guide",
            Summary: "Configuration guide for Visual Studio 2026 Enterprise Edition, including .slnx solution structure, .editorconfig, and launch profiles.",
            Icon: "💻",
            HtmlContent: @"
                <p>Upuaut is configured for development in <strong>Visual Studio 2026 Enterprise Edition</strong> (as well as VS 2022 v17.10+):</p>

                <h4>1. Modern Solution Structure (.slnx)</h4>
                <p>The solution file <code>Upuaut.slnx</code> uses the new streamlined XML solution format. Projects are logically partitioned into <code>/src/</code> and <code>/tests/</code> folders:</p>
                <ul>
                    <li><code>src/Upuaut.App</code>: WPF Desktop Host entrypoint, BlazorWebView configuration, and native lifecycle hooks.</li>
                    <li><code>src/Upuaut.UI</code>: Blazor components, Fluent UI v5 controls, CSS stylesheets, and interactive pages.</li>
                    <li><code>src/Upuaut.Core</code>: Shared models, diagnostic logging (AppLogger), and crash reporter (CrashReporter).</li>
                    <li><code>src/Upuaut.Chronicles</code>: Windows Event Log ingestion engine, XPath query compiler, and The Oracle forensic decoder.</li>
                    <li><code>src/Upuaut.Scout</code>: Driverless raw socket capture engine, IP Helper P/Invoke, and protocol dissectors.</li>
                    <li><code>src/Upuaut.Weigher</code>: early time-proximity preview joining recent Windows warnings/errors with packets already buffered by Scout.</li>
                    <li><code>tests/Upuaut.Tests</code>: Unit test suite for dissectors, log decoders, and forensic heuristics.</li>
                </ul>

                <h4>2. Launch Profiles &amp; Elevated Debugging</h4>
                <p><code>launchSettings.json</code> in <code>Upuaut.App/Properties</code> contains two distinct F5 launch profiles:</p>
                <ul>
                    <li><strong>Upuaut.App (Standard):</strong> Runs under the current user account for UI development and offline .evtx analysis.</li>
                    <li><strong>Upuaut.App (Elevated Administrator):</strong> Launches with elevated privileges to test live raw socket packet capture and Windows Security logs.</li>
                </ul>

                <h4>3. Code Standards &amp; Workload Manifest</h4>
                <p>The repository includes <code>.editorconfig</code> enforcing C# 13 conventions (file-scoped namespaces, nullable reference types, expression-bodied members) and <code>.vsconfig</code> declaring the required Visual Studio workloads (<code>Microsoft.VisualStudio.Workload.ManagedDesktop</code>, <code>Microsoft.VisualStudio.ComponentGroup.Wpf.Prerequisites</code>, and <code>Microsoft.NetCore.Component.SDK</code>).</p>
            ",
            RawText: "Visual Studio 2026 Enterprise Edition .slnx sln launchSettings.json .editorconfig .vsconfig elevated debugging F5 C# 13"
        ),

        new(
            Id: "cli-and-automation",
            Category: "cli",
            CategoryName: "CLI & Automation",
            Title: "CLI & Automation Guide (run.ps1)",
            Summary: "Reference guide for the run.ps1 build and launch script, UAC auto-elevation, and command-line switches.",
            Icon: "⚡",
            HtmlContent: @"
                <p>Upuaut provides a robust automation script <code>run.ps1</code> located at the repository root. By default, <code>run.ps1</code> requests UAC administrator elevation to unlock raw socket packet sniffing and Security log inspection.</p>

                <h4>Usage &amp; Syntax</h4>
                <pre class=""docs-code""><code>.\run.ps1 [-Configuration &lt;Debug|Release&gt;] [-NoElevate] [-Wait] [-Clean]</code></pre>

                <h4>Parameters</h4>
                <table class=""docs-table"">
                    <thead>
                        <tr>
                            <th>Parameter</th>
                            <th>Type</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>-Configuration</code></td>
                            <td>String</td>
                            <td>Build configuration. Defaults to <code>Debug</code>. Pass <code>Release</code> for optimized production builds.</td>
                        </tr>
                        <tr>
                            <td><code>-NoElevate</code></td>
                            <td>Switch</td>
                            <td>Bypasses the UAC prompt, running Upuaut under standard user privileges (The Scout will run in offline mode).</td>
                        </tr>
                        <tr>
                            <td><code>-Wait</code></td>
                            <td>Switch</td>
                            <td>Keeps the PowerShell console attached to the host process until the application exits.</td>
                        </tr>
                        <tr>
                            <td><code>-Clean</code></td>
                            <td>Switch</td>
                            <td>Performs a full <code>dotnet clean</code> across the solution before compiling.</td>
                        </tr>
                    </tbody>
                </table>
            ",
            RawText: "CLI Automation run.ps1 Configuration NoElevate Wait Clean PowerShell UAC elevated Administrator build"
        )
    };
}
